<Window
    x:Class="SoundMeeter.Views.ObsDockSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OBS dock"
    Width="620"
    Height="640"
    MinWidth="520"
    MinHeight="480"
    Background="#1E1E1E"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="GroupLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#9A9A9A" />
                <Setter Property="Margin" Value="2,0,0,4" />
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="#8C8C8C" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Сервер: включение, порт, состояние  -->
        <StackPanel Grid.Row="0">
            <CheckBox
                Content="Serve the dock while SoundMeeter is running (start it automatically)"
                IsChecked="{Binding Enabled}" />

            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <TextBlock
                    Width="46"
                    VerticalAlignment="Center"
                    Foreground="#CCC"
                    Text="Port:" />
                <TextBox
                    Width="80"
                    VerticalContentAlignment="Center"
                    Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding ToggleServerCommand}"
                    Content="{Binding ServerToggleText}" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#9A9A9A"
                    Text="{Binding Status}" />
            </StackPanel>

            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <TextBox
                    Width="330"
                    IsReadOnly="True"
                    Text="{Binding DockUrl, Mode=OneWay}" />
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding CopyUrlCommand}"
                    Content="Copy URL"
                    ToolTip="Скопировать адрес панели" />
            </StackPanel>
        </StackPanel>

        <!--  Установка дока в OBS  -->
        <Border
            Grid.Row="1"
            Margin="0,10,0,0"
            Padding="8"
            Background="#2B2B2B"
            CornerRadius="3">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding InstallInObsCommand}"
                        Content="Install dock in OBS"
                        ToolTip="Дописать панель в список доков OBS (user.ini). Нужен перезапуск OBS." />
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding RemoveFromObsCommand}"
                        Content="Remove from OBS" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#9A9A9A"
                        Text="{Binding ObsDockStateText}" />
                </StackPanel>

                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="10"
                    Foreground="#7CC48B"
                    Text="{Binding ObsStatus}"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsStatusOk, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="10"
                    Foreground="#E08A8A"
                    Text="{Binding ObsStatus}"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsStatusOk, Converter={StaticResource InverseBoolToVisibility}}" />

                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource Hint}"
                    Text="OBS читает список доков при запуске, поэтому после установки его нужно перезапустить. Если док не появился — View → Docks → Browser Dock и вставить скопированный URL." />
            </StackPanel>
        </Border>

        <!--  Какие каналы показывать  -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    VerticalAlignment="Center"
                    Content="All input channels"
                    IsChecked="{Binding ShowAllInputs}" />
                <CheckBox
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Content="All output channels"
                    IsChecked="{Binding ShowAllOutputs}" />
                <Button
                    Margin="16,0,0,0"
                    Command="{Binding SelectAllCommand}"
                    Content="Select all" />
                <Button
                    Margin="6,0,0,0"
                    Command="{Binding SelectNoneCommand}"
                    Content="Select none" />
            </StackPanel>
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource Hint}"
                Text="«All …» means every strip of that group. The lists below add specific channels on top of it — useful to keep only a couple of channels in the dock." />
        </StackPanel>

        <!--  Списки каналов  -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupLabel}" Text="INPUTS" />
                <ListBox
                    Background="#2B2B2B"
                    BorderBrush="#3F3F46"
                    IsEnabled="{Binding InputsGroupEnabled}"
                    ItemsSource="{Binding InputChannels}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" ToolTip="{Binding Tooltip}">
                                <TextBlock
                                    FontSize="10"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupLabel}" Text="OUTPUTS" />
                <ListBox
                    Background="#2B2B2B"
                    BorderBrush="#3F3F46"
                    IsEnabled="{Binding OutputsGroupEnabled}"
                    ItemsSource="{Binding OutputChannels}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" ToolTip="{Binding Tooltip}">
                                <TextBlock
                                    FontSize="10"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <!--  Кнопки  -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                Command="{Binding ApplyCommand}"
                Content="Apply"
                IsDefault="True" />
            <Button
                Margin="8,0,0,0"
                Content="Close"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
