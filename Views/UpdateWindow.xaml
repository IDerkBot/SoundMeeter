<Window
    x:Class="SoundMeeter.Views.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SoundMeeter.Converters"
    Title="Обновление SoundMeeter"
    Width="560"
    Height="560"
    MinWidth="480"
    MinHeight="420"
    Background="#1E1E1E"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок и версии  -->
        <StackPanel Grid.Row="0">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Foreground="White"
                Text="{Binding Title}"
                TextWrapping="Wrap" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#9A9A9A"
                    Text="Установлено: " />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#9A9A9A"
                    Text="{Binding CurrentVersion}" />
                <TextBlock
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#4CAF50"
                    Text="→" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#4CAF50"
                    Text="{Binding NewVersion}" />
            </StackPanel>
        </StackPanel>

        <!--  Метаданные релиза  -->
        <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
            <TextBlock
                FontSize="11"
                Foreground="#808080"
                Text="{Binding PublishedAt}" />
            <TextBlock
                Margin="10,0,0,0"
                FontSize="11"
                Foreground="#808080"
                Text="{Binding AssetName}" />
        </StackPanel>

        <!--  Changelog  -->
        <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="10"
            Background="#252526"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock
                    FontFamily="Consolas,Courier New,monospace"
                    FontSize="11"
                    Foreground="#D4D4D4"
                    Text="{Binding ReleaseNotes}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <!--  Прогресс загрузки  -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Height="6" Maximum="100" Value="{Binding Progress}" />
            <TextBlock
                Margin="0,6,0,0"
                FontSize="11"
                Foreground="#9A9A9A"
                Text="{Binding Status}"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,0"
            FontSize="11"
            Foreground="#D08A8A"
            Text="{Binding Status}"
            TextWrapping="Wrap"
            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />

        <!--  Кнопки  -->
        <StackPanel
            Grid.Row="4"
            Margin="0,14,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                Padding="14,5"
                Command="{Binding OpenReleasePageCommand}"
                Content="Открыть в GitHub" />
            <Button
                Margin="0,0,8,0"
                Padding="14,5"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                IsCancel="True"
                Click="OnCloseClick"
                Content="Закрыть" />
            <Button
                Padding="18,5"
                Command="{Binding InstallCommand}"
                Content="Установить"
                IsDefault="True"
                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />
            <Button
                Padding="18,5"
                Command="{Binding CancelCommand}"
                Content="Отмена"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</Window>
