<UserControl
    x:Class="SoundMeeter.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SoundMeeter.Controls"
    xmlns:converters="clr-namespace:SoundMeeter.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:styleControls="clr-namespace:StreamerTools.Style.Controls;assembly=StreamerTools.Style"
    xmlns:wpf="clr-namespace:StreamerTools.Style.AttachedProperties;assembly=StreamerTools.Style"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:BoolToStartStopConverter x:Key="BoolToStartStop" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:PeakToHeightConverter x:Key="PeakToHeight" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEE" />
        </Style>

        <!--  Заголовок группы стрипов (INPUTS/OUTPUTS)  -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>

        <!--  Вертикальный фейдер громкости (в стиле VoiceMeeter)  -->
        <Style x:Key="VoiceFader" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Minimum" Value="-60" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="Width" Value="36" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border
                                Width="8"
                                Margin="0,10"
                                HorizontalAlignment="Center"
                                Background="#141414"
                                BorderBrush="Black"
                                BorderThickness="1"
                                CornerRadius="4" />
                            <Track x:Name="PART_Track" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border
                                                    x:Name="Knob"
                                                    Width="32"
                                                    Height="18"
                                                    Background="#4A4A4E"
                                                    BorderBrush="#888"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                    <Border
                                                        Width="12"
                                                        Height="2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#BBB"
                                                        CornerRadius="1" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Knob" Property="Background" Value="#3AA0E0" />
                                                        <Setter TargetName="Knob" Property="BorderBrush" Value="#7CC4FF" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="Background" Value="#5A5A5E" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  LED-кнопки M / S / MUTE  -->
        <!--  Горизонтальный слайдер параметра (денойзер)  -->
        <Style x:Key="DenSlider" TargetType="Slider">
            <Setter Property="Height" Value="16" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border
                                Height="4"
                                Margin="0,6"
                                VerticalAlignment="Center"
                                Background="#141414"
                                BorderBrush="#333"
                                BorderThickness="1"
                                CornerRadius="2" />
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border
                                                    Height="4"
                                                    Margin="0,6"
                                                    Background="#3AA0E0"
                                                    CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse
                                                    Width="12"
                                                    Height="12"
                                                    Fill="#4A4A4E"
                                                    Stroke="#888" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LedToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#DDD" />
            <Setter Property="Background" Value="#3A3A3D" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4E" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FA3FF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#1B81D6" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Кнопки вывода OUT / VIRT  -->
        <Style x:Key="RouteBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#DDD" />
            <Setter Property="Background" Value="#3A3A3D" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeviceCard" TargetType="Border">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="MinHeight" Value="60" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="BorderBrush" Value="#007ACC" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="#333337" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppCard" TargetType="Border">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <!--  Поле поиска с подсказкой (Watermark)  -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#3F3F46" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                                <TextBlock
                                    x:Name="Placeholder"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#808080"
                                    IsHitTestVisible="False"
                                    Text="🔍 Поиск по названию, издателю..."
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Чекбокс выбора выхода в попапе  -->
        <DataTemplate x:Key="OutputOptionTemplate">
            <DockPanel Margin="0,3" LastChildFill="True">
                <Button
                    Width="16"
                    Height="16"
                    Margin="2,0,0,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding HideCommand}"
                    Content="✕"
                    DockPanel.Dock="Right"
                    FontSize="10"
                    Foreground="#888"
                    ToolTip="Hide this output device from all strips" />
                <CheckBox
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding IsEnabled, Mode=TwoWay}">
                    <TextBlock
                        FontSize="10"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Name}" />
                </CheckBox>
            </DockPanel>
        </DataTemplate>

        <!--
            Редактируемое имя канала (сверху стрипа, над именем устройства).
            ЛКМ/ПКМ по имени, Enter — сохранить, Esc — отменить.
        -->
        <DataTemplate x:Key="StripTitleTemplate">
            <Grid
                MinHeight="16"
                Margin="0,0,0,2"
                Background="Transparent"
                MouseRightButtonUp="OnStripTitleRightClick">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Title}"
                    Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}" />
                <TextBox
                    VerticalAlignment="Center"
                    FontSize="11"
                    IsVisibleChanged="OnRenameBoxIsVisibleChanged"
                    KeyDown="OnRenameKeyDown"
                    LostFocus="OnRenameLostFocus"
                    Text="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!--  Общие элементы вертикального стрипа: VU-метр (40×2) + фейдер  -->
        <DataTemplate x:Key="MeterAndFader">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:SegmentedMeter
                    Grid.Column="0"
                    Width="14"
                    Height="300"
                    Margin="2,0,8,0"
                    Columns="2"
                    Level="{Binding PeakLevel}"
                    Segments="40" />
                <Slider
                    Grid.Column="1"
                    Style="{StaticResource VoiceFader}"
                    Value="{Binding VolumeDb, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </DataTemplate>

        <!--  Входной стрип  -->
        <DataTemplate x:Key="InputStripTemplate">
            <Border
                Width="138"
                MinHeight="200"
                Margin="0,0,10,6"
                Padding="6"
                AllowDrop="True"
                CornerRadius="3"
                DragEnter="Device_DragEnter"
                DragLeave="Device_DragLeave"
                DragOver="Device_DragEnter"
                Drop="Device_Drop">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#3E3E42" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter Property="BorderBrush" Value="#4FC3F7" />
                                <Setter Property="Background" Value="#354B58" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Имя канала: сверху стрипа, над именем устройства (ПКМ — переименовать).  -->
                    <ContentControl
                        Grid.Row="0"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource StripTitleTemplate}" />

                    <DockPanel
                        Grid.Row="1"
                        Margin="0,0,0,4"
                        LastChildFill="True">
                        <Button
                            Width="18"
                            Height="18"
                            Margin="4,0,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding DataContext.RemoveInputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Id}"
                            Content="×"
                            DockPanel.Dock="Right"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#AAA"
                            ToolTip="Remove strip" />
                        <Button
                            Padding="0"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnInputNameClick"
                            Content="{Binding Name}"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            ToolTip="Choose input source" />
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentControl
                            Grid.Row="0"
                            Grid.Column="0"
                            Height="200"
                            VerticalAlignment="Top"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource MeterAndFader}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,2,0,4"
                            HorizontalAlignment="Center"
                            FontSize="10"
                            Foreground="#AAA"
                            Text="{Binding VolumeDb, StringFormat={}{0:F1} dB}" />

                        <UniformGrid
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Columns="1">
                            <Button
                                x:Name="OutBtn"
                                Margin="2"
                                Click="OnRouteButtonClick"
                                Content="{Binding OutButtonText}"
                                IsEnabled="{Binding HasHardware}"
                                Style="{StaticResource RouteBtn}"
                                Tag="{Binding ElementName=OutPopup}"
                                ToolTip="Hardware outputs (для прослушивания)" />
                            <Button
                                x:Name="VirtBtn"
                                Margin="2"
                                Click="OnRouteButtonClick"
                                Content="{Binding VirtButtonText}"
                                IsEnabled="{Binding HasVirtual}"
                                Style="{StaticResource RouteBtn}"
                                Tag="{Binding ElementName=VirtPopup}"
                                ToolTip="Virtual outputs (VB-Cable / VAC)" />
                            <ToggleButton
                                Margin="2"
                                Content="MONO"
                                IsChecked="{Binding IsMono}"
                                Style="{StaticResource LedToggle}"
                                ToolTip="Mono" />
                            <ToggleButton
                                Margin="2"
                                Content="SOLO"
                                IsChecked="{Binding IsSolo}"
                                Style="{StaticResource LedToggle}"
                                ToolTip="Solo" />
                            <ToggleButton
                                Margin="2"
                                Content="MUTE"
                                IsChecked="{Binding IsMuted}"
                                Style="{StaticResource LedToggle}"
                                ToolTip="Mute" />
                            <ToggleButton
                                x:Name="DenBtn"
                                Margin="2"
                                Content="DEN"
                                IsChecked="{Binding DenoiserEnabled}"
                                MouseRightButtonUp="OnDenRightClick"
                                Style="{StaticResource LedToggle}"
                                Tag="{Binding ElementName=DenPopup}"
                                ToolTip="Denoiser (RNNoise): настройки — ПКМ" />
                        </UniformGrid>

                        <Popup
                            x:Name="OutPopup"
                            Width="240"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=OutBtn}"
                            StaysOpen="False">
                            <Border
                                Padding="6"
                                Background="#2B2B2B"
                                BorderBrush="#555"
                                BorderThickness="1"
                                CornerRadius="3">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Text="Hardware outputs (для прослушивания)" />
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemTemplate="{StaticResource OutputOptionTemplate}" ItemsSource="{Binding HardwareOutputs}" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Popup
                            x:Name="VirtPopup"
                            Width="240"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=VirtBtn}"
                            StaysOpen="False">
                            <Border
                                Padding="6"
                                Background="#2B2B2B"
                                BorderBrush="#555"
                                BorderThickness="1"
                                CornerRadius="3">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Text="Virtual outputs (VB-Cable / VAC)" />
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemTemplate="{StaticResource OutputOptionTemplate}" ItemsSource="{Binding VirtualOutputs}" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Popup
                            x:Name="DenPopup"
                            Width="240"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=DenBtn}"
                            StaysOpen="False">
                            <Border
                                Padding="6"
                                Background="#2B2B2B"
                                BorderBrush="#555"
                                BorderThickness="1"
                                CornerRadius="3">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Text="Denoiser (RNNoise)" />
                                    <StackPanel>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontSize="10"
                                                Text="Noise Remover" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="10"
                                                Foreground="#9A9A9A"
                                                Text="{Binding DenoiserNoiseRemover, StringFormat={}{0:F0}%}" />
                                        </Grid>
                                        <Slider
                                            Maximum="100"
                                            Minimum="0"
                                            Style="{StaticResource DenSlider}"
                                            Value="{Binding DenoiserNoiseRemover}" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontSize="10"
                                                Text="Dry / Wet Balance" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="10"
                                                Foreground="#9A9A9A"
                                                Text="{Binding DenoiserDryWet, StringFormat={}{0:F0}%}" />
                                        </Grid>
                                        <Slider
                                            Maximum="100"
                                            Minimum="0"
                                            Style="{StaticResource DenSlider}"
                                            Value="{Binding DenoiserDryWet}" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontSize="10"
                                                Text="Formant Low" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="10"
                                                Foreground="#9A9A9A"
                                                Text="{Binding DenoiserFormantLowDb, StringFormat={}{0:F1} dB}" />
                                        </Grid>
                                        <Slider
                                            Maximum="24"
                                            Minimum="-24"
                                            Style="{StaticResource DenSlider}"
                                            Value="{Binding DenoiserFormantLowDb}" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontSize="10"
                                                Text="Formant Medium" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="10"
                                                Foreground="#9A9A9A"
                                                Text="{Binding DenoiserFormantMidDb, StringFormat={}{0:F1} dB}" />
                                        </Grid>
                                        <Slider
                                            Maximum="24"
                                            Minimum="-24"
                                            Style="{StaticResource DenSlider}"
                                            Value="{Binding DenoiserFormantMidDb}" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontSize="10"
                                                Text="Formant High" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="10"
                                                Foreground="#9A9A9A"
                                                Text="{Binding DenoiserFormantHighDb, StringFormat={}{0:F1} dB}" />
                                        </Grid>
                                        <Slider
                                            Maximum="24"
                                            Minimum="-24"
                                            Style="{StaticResource DenSlider}"
                                            Value="{Binding DenoiserFormantHighDb}" />
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontSize="10"
                                                Text="Formant Group" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="10"
                                                Foreground="#9A9A9A"
                                                Text="{Binding DenoiserFormantGroupDb, StringFormat={}{0:F1} dB}" />
                                        </Grid>
                                        <Slider
                                            Maximum="12"
                                            Minimum="-12"
                                            Style="{StaticResource DenSlider}"
                                            Value="{Binding DenoiserFormantGroupDb}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Border
                        x:Name="AddedApps"
                        Grid.Row="3"
                        MinHeight="30"
                        MaxHeight="120"
                        Background="#1a1a1a"
                        CornerRadius="6">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    Margin="4"
                                    FontSize="10"
                                    Foreground="#AAA"
                                    Text="{Binding AppDropHint}"
                                    TextWrapping="Wrap" />
                                <!--  Активные приложения  -->
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding AssignedApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,2"
                                                Padding="6"
                                                Background="#3F3F46"
                                                CornerRadius="4"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="App_MouseLeftButtonDown"
                                                PreviewMouseMove="App_PreviewMouseMove"
                                                ToolTip="{Binding Name}">
                                                <DockPanel>
                                                    <!--  ИСПРАВЛЕНО: надежный биндинг через ElementName  -->
                                                    <Button
                                                        Width="22"
                                                        Height="22"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="RemoveStripApp_Click"
                                                        Content="✕"
                                                        Cursor="Hand"
                                                        DockPanel.Dock="Right"
                                                        FontSize="10"
                                                        Foreground="#FF6B6B"
                                                        ToolTip="Сбросить на устройство по умолчанию" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image
                                                            Width="16"
                                                            Height="16"
                                                            Margin="0,0,6,0"
                                                            Source="{Binding Icon}" />
                                                        <TextBlock
                                                            MaxWidth="160"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="#E0E0E0"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  НОВЫЙ БЛОК: Ожидающие запуска приложения (Wave Link style)  -->
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ConfiguredApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,2"
                                                Padding="6"
                                                Background="#2D2D30"
                                                BorderBrush="#555555"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="App_MouseLeftButtonDown"
                                                Opacity="0.7"
                                                PreviewMouseMove="App_PreviewMouseMove"
                                                ToolTip="{Binding ExecutablePath}">
                                                <DockPanel>
                                                    <Button
                                                        Width="22"
                                                        Height="22"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="RemoveStripApp_Click"
                                                        Content="✕"
                                                        Cursor="Hand"
                                                        DockPanel.Dock="Right"
                                                        FontSize="10"
                                                        Foreground="#FF6B6B"
                                                        ToolTip="Удалить правило" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image
                                                            Width="16"
                                                            Height="16"
                                                            Margin="0,0,6,0"
                                                            Source="{Binding Icon}" />
                                                        <StackPanel>
                                                            <TextBlock
                                                                MaxWidth="160"
                                                                FontSize="12"
                                                                Foreground="#A0A0A0"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="9"
                                                                Foreground="#666666"
                                                                Text="Ожидает аудиосессии / применения"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Выходной стрип (шина)  -->
        <DataTemplate x:Key="BusStripTemplate">
            <Border
                Width="138"
                Margin="0,0,10,6"
                Padding="6"
                Background="#3E3E42"
                CornerRadius="3"
                Opacity="{Binding IsAvailable, Converter={StaticResource BoolToOpacity}}">
                <StackPanel>
                    <!--  Имя канала: сверху стрипа, над именем устройства (ПКМ — переименовать).  -->
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StripTitleTemplate}" />

                    <DockPanel Margin="0,0,0,4" LastChildFill="True">
                        <Button
                            Width="18"
                            Height="18"
                            Margin="4,0,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding DataContext.RemoveBusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Model.Id}"
                            Content="×"
                            DockPanel.Dock="Right"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#AAA"
                            ToolTip="Remove strip" />
                        <Button
                            Padding="0"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnBusNameClick"
                            Content="{Binding Name}"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            ToolTip="Choose output device" />
                    </DockPanel>

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MeterAndFader}" />

                    <TextBlock
                        Margin="0,2,0,4"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        Foreground="#AAA"
                        Text="{Binding VolumeDb, StringFormat={}{0:F1} dB}" />

                    <UniformGrid Columns="3">
                        <ToggleButton
                            Margin="0,0,2,0"
                            Content="M"
                            IsChecked="{Binding IsMono}"
                            Style="{StaticResource LedToggle}"
                            ToolTip="Mono" />
                        <ToggleButton
                            Margin="1,0"
                            Content="S"
                            IsChecked="{Binding IsSolo}"
                            Style="{StaticResource LedToggle}"
                            ToolTip="Solo" />
                        <ToggleButton
                            Margin="2,0,0,0"
                            Content="MUTE"
                            IsChecked="{Binding IsMuted}"
                            Style="{StaticResource LedToggle}"
                            ToolTip="Mute" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height=".9*" />
        </Grid.RowDefinitions>

        <!--  Панель инструментов  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,8"
            Orientation="Horizontal">
            <Button
                Height="34"
                Margin="0,0,6,0"
                Command="{Binding RefreshCommand}"
                Content="Refresh devices" />
            <Button
                Height="34"
                Margin="0,0,6,0"
                Click="OnMidiClick"
                Content="MIDI" />
            <Button
                Height="34"
                Margin="0,0,6,0"
                Click="OnCheckUpdatesClick"
                Content="Updates"
                ToolTip="Проверить обновления через GitHub Releases" />
            <Button
                Height="34"
                Command="{Binding ToggleRunCommand}"
                Content="{Binding IsRunning, Converter={StaticResource BoolToStartStop}}">
                <Button.Resources>
                    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                        <Setter Property="wpf:Button.LeftIcon" Value="Play" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="wpf:Button.LeftIcon" Value="Stop" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding Status}" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="#7E9C7E"
                Text="{Binding UpdateStatus}" />
        </StackPanel>

        <!--  Советы: нет виртуального кабеля / доступно обновление  -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border
                Margin="0,0,0,6"
                Padding="8,5"
                Background="#1F4A2B"
                CornerRadius="3"
                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Click="OnUpdateInstallClick"
                        Content="Update" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding UpdateBanner}" />
                    <Button
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding DismissUpdateCommand}"
                        Content="✕"
                        ToolTip="Скрыть до следующей проверки" />
                </DockPanel>
            </Border>

            <Border
                Padding="8,5"
                Background="#5A3B00"
                CornerRadius="3"
                Visibility="{Binding HasVirtualCable, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="No virtual cable detected. For virtual channels (CABLE Input / Output) install VB-Cable from vb-audio.com — apps then pick 'CABLE Input' as their audio device." />
            </Border>
        </StackPanel>

        <!--  Стрипы: входы и выходы  -->
        <ScrollViewer
            Grid.Row="2"
            VerticalAlignment="Stretch"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource GroupHeader}"
                            Text="INPUTS" />
                        <Button
                            Width="20"
                            Height="20"
                            Margin="8,0,0,0"
                            Padding="0"
                            Command="{Binding AddInputCommand}"
                            Content="＋"
                            FontSize="14"
                            ToolTip="Add input strip" />
                    </StackPanel>
                    <ItemsControl ItemTemplate="{StaticResource InputStripTemplate}" ItemsSource="{Binding Inputs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <Border
                    Width="1"
                    Margin="4,20,10,0"
                    Background="#3F3F46" />

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GroupHeader}" Text="OUTPUTS" />
                        <Button
                            Width="20"
                            Height="20"
                            Margin="8,0,0,0"
                            Padding="0"
                            Command="{Binding AddBusCommand}"
                            Content="＋"
                            FontSize="14"
                            ToolTip="Add output strip" />
                    </StackPanel>
                    <ItemsControl ItemTemplate="{StaticResource BusStripTemplate}" ItemsSource="{Binding Buses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>


        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Padding="5"
                Background="{StaticResource SecondaryBrush}">
                <DockPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Audio Router" />
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding RefreshDataCommand}"
                        Content="Обновить" />
                </DockPanel>
            </Border>

            <!--  Main Content  -->
            <Grid Grid.Row="1" Margin="5">

                <Grid Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Running Apps  -->
                    <Border
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        Padding="15"
                        Background="#252526"
                        CornerRadius="8">
                        <DockPanel>
                            <TextBlock
                                Margin="0,0,0,15"
                                DockPanel.Dock="Top"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Приложения с аудио" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RunningApps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Width="110"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="App_MouseLeftButtonDown"
                                                PreviewMouseMove="App_PreviewMouseMove"
                                                Style="{StaticResource AppCard}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,0,8"
                                                        Source="{Binding Icon}" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="White"
                                                        Text="{Binding Name}"
                                                        TextAlignment="Center"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!--  Installed Apps (новый список)  -->
                    <Border
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Padding="15"
                        Background="#252526"
                        CornerRadius="8">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="Все установленные приложения" />

                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <TextBox
                                        Width="250"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource SearchTextBox}"
                                        Text="{Binding InstalledAppsSearchText, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button
                                        HorizontalAlignment="Right"
                                        Command="{Binding LoadInstalledAppsCommand}"
                                        Content="Обновить список"
                                        IsEnabled="{Binding IsLoadingInstalledApps, Converter={StaticResource InverseBoolConverter}}" />
                                </StackPanel>
                            </DockPanel>

                            <!--  Индикатор загрузки  -->
                            <TextBlock
                                Margin="10,10,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Foreground="#808080"
                                Text="Загрузка списка приложений..."
                                Visibility="{Binding IsLoadingInstalledApps, Converter={StaticResource BoolToVisibility}}" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLoadingInstalledApps, Converter={StaticResource InverseBoolToVisibility}}">
                                <!--  ИЗМЕНЕНО: ItemsSource теперь привязан к FilteredInstalledApps  -->
                                <ItemsControl ItemsSource="{Binding FilteredInstalledApps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--  ДОБАВЛЕНЫ: PreviewMouseMove, MouseLeftButtonDown, Cursor  -->
                                            <Border
                                                Width="120"
                                                Height="100"
                                                Margin="5"
                                                Padding="10"
                                                Background="#2D2D30"
                                                BorderBrush="#3F3F46"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="App_MouseLeftButtonDown"
                                                PreviewMouseMove="App_PreviewMouseMove"
                                                ToolTip="{Binding Publisher}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Image
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,0,5"
                                                        HorizontalAlignment="Center"
                                                        Source="{Binding Icon}" />

                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Margin="0,5"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="White"
                                                        Text="{Binding Name}"
                                                        TextAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap" />

                                                    <TextBlock
                                                        Grid.Row="2"
                                                        FontSize="9"
                                                        Foreground="#808080"
                                                        Text="{Binding Version}"
                                                        TextAlignment="Center"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
