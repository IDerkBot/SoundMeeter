<UserControl
    x:Class="SoundMeeter.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SoundMeeter.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height=".7*" />
        </Grid.RowDefinitions>

        <!--  Панель инструментов; баннер обновления накладывается справа  -->
        <Grid Grid.Row="0">
            <controls:MixerToolbarView />
            <controls:UpdateBannerView />
        </Grid>

        <!--  Советы: нет виртуального кабеля  -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border
                Padding="8,5"
                Background="#5A3B00"
                CornerRadius="3"
                Visibility="{Binding HasVirtualCable, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="No virtual cable detected. For virtual channels (CABLE Input / Output) install VB-Cable from vb-audio.com — apps then pick 'CABLE Input' as their audio device." />
            </Border>
        </StackPanel>

        <!--  Стрипы: входы и выходы  -->
        <controls:MixerView Grid.Row="2" />

        <!--  Приложения с аудио и установленные приложения  -->
        <Grid Grid.Row="3" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:RunningAppsView Grid.Column="0" />
            <controls:InstalledAppsView Grid.Column="1" />
        </Grid>
    </Grid>
</UserControl>
