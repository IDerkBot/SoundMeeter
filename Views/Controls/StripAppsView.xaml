<UserControl
    x:Class="SoundMeeter.Views.Controls.StripAppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="130"
    d:DesignWidth="126"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        MinHeight="30"
        MaxHeight="120"
        Background="#1a1a1a"
        CornerRadius="6">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="4"
                    FontSize="10"
                    Foreground="#AAA"
                    Text="{Binding AppDropHint}"
                    TextWrapping="Wrap" />

                <!--  Активные приложения  -->
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding AssignedApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,2"
                                Padding="6"
                                Background="#3F3F46"
                                CornerRadius="4"
                                Cursor="Hand"
                                MouseLeftButtonDown="App_MouseLeftButtonDown"
                                PreviewMouseMove="App_PreviewMouseMove"
                                ToolTip="{Binding Name}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            Source="{Binding Icon}" />
                                        <TextBlock
                                            MaxWidth="160"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#E0E0E0"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Width="22"
                                        Height="22"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveStripApp_Click"
                                        Content="✕"
                                        Cursor="Hand"
                                        FontSize="10"
                                        Foreground="#FF6B6B"
                                        ToolTip="Сбросить на устройство по умолчанию" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Ожидающие запуска приложения (Wave Link style)  -->
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ConfiguredApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,2"
                                Padding="6"
                                Background="#2D2D30"
                                BorderBrush="#555555"
                                BorderThickness="1"
                                CornerRadius="4"
                                Cursor="Hand"
                                MouseLeftButtonDown="App_MouseLeftButtonDown"
                                Opacity="0.7"
                                PreviewMouseMove="App_PreviewMouseMove"
                                ToolTip="{Binding ExecutablePath}">
                                <DockPanel>
                                    <Button
                                        Width="22"
                                        Height="22"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveStripApp_Click"
                                        Content="✕"
                                        Cursor="Hand"
                                        DockPanel.Dock="Right"
                                        FontSize="10"
                                        Foreground="#FF6B6B"
                                        ToolTip="Удалить правило" />
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            Source="{Binding Icon}" />
                                        <StackPanel>
                                            <TextBlock
                                                MaxWidth="160"
                                                FontSize="12"
                                                Foreground="#A0A0A0"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="9"
                                                Foreground="#666666"
                                                Text="Ожидает аудиосессии / применения"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
