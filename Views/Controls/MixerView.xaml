<UserControl
    x:Class="SoundMeeter.Views.Controls.MixerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SoundMeeter.Views.Controls"
    xmlns:panels="clr-namespace:SoundMeeter.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Группы INPUTS/OUTPUTS — сетки, а не StackPanel: иначе лента стрипов
        прижимается к верху и не добирает высоту окна (прокрутка только
        горизонтальная, высоту viewport отдаёт целиком).
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource GroupHeader}"
                        Text="INPUTS" />
                    <Button
                        Width="20"
                        Height="20"
                        Margin="8,0,0,0"
                        Padding="0"
                        Command="{Binding AddInputCommand}"
                        Content="＋"
                        FontSize="14"
                        ToolTip="Add input strip" />
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <panels:HorizontalFillPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:InputStripView RemoveCommand="{Binding DataContext.RemoveInputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Border
                Grid.Column="1"
                Width="1"
                Margin="4,20,10,0"
                Background="#3F3F46" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GroupHeader}" Text="OUTPUTS" />
                    <Button
                        Width="20"
                        Height="20"
                        Margin="8,0,0,0"
                        Padding="0"
                        Command="{Binding AddBusCommand}"
                        Content="＋"
                        FontSize="14"
                        ToolTip="Add output strip" />
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Buses}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <panels:HorizontalFillPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:OutputStripView RemoveCommand="{Binding DataContext.RemoveBusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
