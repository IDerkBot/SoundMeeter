<ResourceDictionary
    x:Class="SoundMeeter.Views.Controls.MixerTheme"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SoundMeeter.Controls"
    xmlns:strip="clr-namespace:SoundMeeter.Views.Controls"
    xmlns:converters="clr-namespace:SoundMeeter.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#EEE" />
    </Style>

    <!--  Заголовок группы стрипов (INPUTS/OUTPUTS)  -->
    <Style x:Key="GroupHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#9A9A9A" />
        <Setter Property="Margin" Value="2,0,0,6" />
    </Style>

    <!--  Вертикальный фейдер громкости (в стиле VoiceMeeter)  -->
    <Style x:Key="VoiceFader" TargetType="Slider">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Minimum" Value="-60" />
        <Setter Property="Maximum" Value="12" />
        <Setter Property="Width" Value="36" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border
                            Width="8"
                            Margin="0,10"
                            HorizontalAlignment="Center"
                            Background="#141414"
                            BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="4" />
                        <Track x:Name="PART_Track" Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border
                                                x:Name="Knob"
                                                Width="32"
                                                Height="18"
                                                Background="#4A4A4E"
                                                BorderBrush="#888"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <Border
                                                    Width="12"
                                                    Height="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#BBB"
                                                    CornerRadius="1" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Knob" Property="Background" Value="#3AA0E0" />
                                                    <Setter TargetName="Knob" Property="BorderBrush" Value="#7CC4FF" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Background" Value="#5A5A5E" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Горизонтальный слайдер параметра (денойзер)  -->
    <Style x:Key="DenSlider" TargetType="Slider">
        <Setter Property="Height" Value="16" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border
                            Height="4"
                            Margin="0,6"
                            VerticalAlignment="Center"
                            Background="#141414"
                            BorderBrush="#333"
                            BorderThickness="1"
                            CornerRadius="2" />
                        <Track x:Name="PART_Track" Orientation="Horizontal">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border
                                                Height="4"
                                                Margin="0,6"
                                                Background="#3AA0E0"
                                                CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse
                                                Width="12"
                                                Height="12"
                                                Fill="#4A4A4E"
                                                Stroke="#888" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  LED-кнопки M / S / MUTE  -->
    <Style x:Key="LedToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#DDD" />
        <Setter Property="Background" Value="#3A3A3D" />
        <Setter Property="BorderBrush" Value="#555" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="UltraExpanded" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4A4A4E" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#fc4747" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#d90404" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#e7362f" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Кнопки вывода OUT / VIRT  -->
    <Style x:Key="RouteBtn" TargetType="Button">
        <Setter Property="Foreground" Value="#DDD" />
        <Setter Property="Background" Value="#3A3A3D" />
        <Setter Property="BorderBrush" Value="#555" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,3" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4A4A4E" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2A2E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

<!--
        Кнопки FUNC стрипа: работают как переключатели. Под нажатой кнопкой
        роутинг стрипа принадлежит её правилу, повторное нажатие возвращает
        прежний роутинг, поэтому состояние рисуется обычным Trigger на IsChecked
        (никаких привязок в триггерах — см. ниже про MultiDataTrigger).

        Все условия живут в Style.Triggers, а не в ControlTemplate.Triggers:
        Binding-условия внутри шаблона недопустимы. Отдельного оттенка «нажата и
        наведена» не делаем — MultiDataTrigger со смешанными условиями
        (Binding + Property) в этом словаре падает на Condition.Seal, а порядок
        триггеров и так отдаёт нажатое состояние последним.
    -->
    <Style x:Key="FuncBtn" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#DDD" />
        <Setter Property="Background" Value="#3A3A3D" />
        <Setter Property="BorderBrush" Value="#555" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,3" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4A4A4E" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#2A2A2E" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#1E4A63" />
                <Setter Property="BorderBrush" Value="#3AA0E0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Строка выбора выхода в попапе кнопки FUNC: чекбокс назначения и точка
        «стрип идёт сюда сейчас» — назначение и текущий роутинг разведены
        (кнопку можно настроить, не включив маршрут).
    -->
    <DataTemplate x:Key="FuncTargetTemplate">
        <Grid Height="18" Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox
                Grid.Column="0"
                VerticalAlignment="Center"
                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
            <TextBlock
                Grid.Column="1"
                Margin="4,0,4,0"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="White"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding ToolTip}" />
            <Ellipse
                Grid.Column="2"
                Width="7"
                Height="7"
                VerticalAlignment="Center"
                ToolTip="{DynamicResource Sm.Func.LiveTip}">
                <!--  Цвет задаётся только стилем: локальное Fill перебило бы триггер  -->
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#4A4A4E" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Fill" Value="#3AA0E0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </Grid>
    </DataTemplate>

    <!--
        Крутилка параметра эффекта стрипа (SM-B05). Тот же контрол GainKnob, что
        и у входного Gain микрофона: параметр, который пользователь уже знает по
        стрипу микрофона, выглядит так же. Ширина 78 — три крутилки в ряд в
        попапе эффекта.
    -->
    <DataTemplate x:Key="EffectKnobTemplate">
        <StackPanel Width="78" Margin="0,4,0,0">
            <controls:GainKnob
                Width="56"
                Height="56"
                HorizontalAlignment="Center"
                Maximum="{Binding Maximum}"
                Minimum="{Binding Minimum}"
                ToolTip="{Binding ToolTip}"
                Value="{Binding Value, Mode=TwoWay}"
                strip:ParamReset.Command="{Binding ResetCommand}" />
            <TextBlock
                Margin="0,2,0,0"
                HorizontalAlignment="Center"
                FontSize="9"
                Foreground="#9A9A9A"
                Text="{Binding Name}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="9"
                Foreground="#EEE"
                Text="{Binding Display}" />
        </StackPanel>
    </DataTemplate>

    <!--
        Кнопки эффектов стрипа: работают как переключатели (ЛКМ), ПКМ — попап с
        параметрами. Отключать их нельзя: у отключённого элемента не приходит
        ПКМ, и настроить эффект было бы нечем. Состояние показывает IsChecked
        обычного ToggleButton, а не привязкой в стиле — так тот же стиль
        годится и для других переключателей стрипа.
    -->
    <Style x:Key="EffectBtn" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#DDD" />
        <Setter Property="Background" Value="#3A3A3D" />
        <Setter Property="BorderBrush" Value="#555" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="Height" Value="20" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4A4A4E" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#1E4A63" />
                <Setter Property="BorderBrush" Value="#3AA0E0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Строка выпадающего меню (иконка + текст, текст слева)  -->
    <Style x:Key="MenuRow" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#DDD" />
        <Setter Property="Height" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="2">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3F3F46" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2A2E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppCard" TargetType="Border">
        <Setter Property="Background" Value="#2D2D30" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!--  Поле поиска с подсказкой (Watermark)  -->
    <Style x:Key="SearchTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#3F3F46" />
        <Setter Property="BorderBrush" Value="#555555" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="8,6" />
        <!--
            Подсказка (watermark) берётся из Tag, чтобы каждый экран
            мог задать свою подсказку, не копируя шаблон.
        -->
        <Setter Property="Tag" Value="{DynamicResource Sm.Apps.SearchHint}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            <TextBlock
                                x:Name="Placeholder"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#808080"
                                IsHitTestVisible="False"
                                Text="{TemplateBinding Tag}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#007ACC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Чекбокс выбора выхода + индивидуальная посылка в этот выход (дБ)  -->
    <DataTemplate x:Key="OutputOptionTemplate">
        <StackPanel Margin="0,3">
            <DockPanel LastChildFill="True">
                <Button
                    Width="16"
                    Height="16"
                    Margin="2,0,0,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding HideCommand}"
                    Content="✕"
                    DockPanel.Dock="Right"
                    FontSize="10"
                    Foreground="#888"
                    ToolTip="{DynamicResource Sm.OutputOption.HideTip}" />
                <CheckBox
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    IsChecked="{Binding IsEnabled, Mode=TwoWay}">
                    <TextBlock
                        FontSize="10"
                        Foreground="White"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding ToolTip}" />
                </CheckBox>
            </DockPanel>

            <!--
                Посылка в этот выход: тот же параметр GainDb, что хранится
                в settings.json. Показывается только у включённого маршрута.
            -->
            <DockPanel Margin="20,1,2,0" Visibility="{Binding ShowGain, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    Width="34"
                    VerticalAlignment="Center"
                    FontSize="9"
                    Foreground="#9A9A9A"
                    Text="{Binding GainText}" />
                <Slider
                    Height="14"
                    IsMoveToPointEnabled="True"
                    IsSnapToTickEnabled="False"
                    LargeChange="1"
                    Maximum="{Binding MaxGainDb}"
                    Minimum="{Binding MinGainDb}"
                    SmallChange="0.5"
                    Style="{StaticResource DenSlider}"
                    ToolTip="{DynamicResource Sm.OutputOption.GainTip}"
                    Value="{Binding GainDb, Mode=TwoWay}"
                    strip:ParamReset.Command="{Binding ResetGainCommand}" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!--
        Поверхность имени стрипа и поле правки подключены к code-
        behind через EventSetter: внутри общего DataTemplate нельзя указать
        имя обработчика из XAML.
    -->
    <Style x:Key="StripTitleSurface" TargetType="Grid">
        <Setter Property="Cursor" Value="SizeAll" />
        <EventSetter Event="MouseRightButtonUp" Handler="OnStripTitleRightClick" />
    </Style>


    <Style x:Key="StripTitleRenameBox" TargetType="TextBox">
        <EventSetter Event="KeyDown" Handler="OnRenameKeyDown" />
        <EventSetter Event="LostFocus" Handler="OnRenameLostFocus" />
    </Style>

    <!--
        Редактируемое имя канала (сверху стрипа, над именем устройства).
        ЛКМ/ПКМ по имени, Enter — сохранить, Esc — отменить.
    -->
    <DataTemplate x:Key="StripTitleTemplate">
        <Grid
            MinHeight="16"
            Margin="0,0,0,2"
            Background="Transparent"
            Style="{StaticResource StripTitleSurface}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="11"
                FontWeight="Bold"
                Foreground="White"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Title}"
                Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBox
                VerticalAlignment="Center"
                FontSize="11"
                Style="{StaticResource StripTitleRenameBox}"
                Text="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DataTemplate>

    <!--  Общие элементы вертикального стрипа: VU-метр (40×2) + фейдер  -->
    <DataTemplate x:Key="MeterAndFader">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:SegmentedMeter
                Grid.Column="0"
                Width="14"
                Height="300"
                Margin="2,0,8,0"
                Columns="2"
                Level="{Binding PeakLevel}"
                Segments="40" />
            <Slider
                Grid.Column="1"
                Style="{StaticResource VoiceFader}"
                strip:ParamReset.Command="{Binding ResetVolumeCommand}"
                Value="{Binding VolumeDb, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>