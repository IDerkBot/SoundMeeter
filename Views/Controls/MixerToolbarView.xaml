<UserControl
    x:Class="SoundMeeter.Views.Controls.MixerToolbarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpf="clr-namespace:StreamerTools.Style.AttachedProperties;assembly=StreamerTools.Style"
    d:DesignHeight="34"
    d:DesignWidth="700"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
        <Button
            Height="34"
            Margin="0,0,6,0"
            Command="{Binding RefreshCommand}"
            Content="Refresh devices" />
        <Button
            Height="34"
            Margin="0,0,6,0"
            Click="OnMidiClick"
            Content="MIDI" />
        <Button
            Height="34"
            Margin="0,0,6,0"
            Click="OnObsDockClick"
            Content="OBS"
            ToolTip="Док-панель в OBS: VU-метр, фейдер и Mute/Solo прямо в OBS" />
        <Button
            Height="34"
            Margin="0,0,6,0"
            Click="OnCheckUpdatesClick"
            Content="Updates"
            ToolTip="Проверить обновления через GitHub Releases" />
        <Button
            Height="34"
            Margin="0,0,6,0"
            Click="OnLogsClick"
            Content="Logs"
            ToolTip="Журнал работы приложения, уровень детализации и копирование диагностики" />
        <Button
            Height="34"
            Command="{Binding ToggleRunCommand}"
            Content="{Binding IsRunning, Converter={StaticResource BoolToStartStop}}">
            <Button.Resources>
                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                    <Setter Property="wpf:Button.LeftIcon" Value="Play" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="wpf:Button.LeftIcon" Value="Stop" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Resources>
        </Button>
        <TextBlock
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Text="{Binding Status}" />
        <TextBlock
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Foreground="#7E9C7E"
            Text="{Binding UpdateStatus}" />
    </StackPanel>
</UserControl>
