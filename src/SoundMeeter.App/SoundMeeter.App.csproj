<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>SoundMeeter</AssemblyName>
    <RootNamespace>SoundMeeter</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.2</Version>
    <ApplicationIcon>Resources\Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="WarnWithoutSingleFileProfile" BeforeTargets="Publish" Condition="'$(PublishSingleFile)' != 'true'">
    <Warning Code="SM0001" Text="Публикация без профиля portable: рядом с exe появятся DLL и json. Для релиза используйте: dotnet publish src\SoundMeeter.App\SoundMeeter.App.csproj -p:PublishProfile=portable -c Release" />
  </Target>

  <ItemGroup>
    <Content Include="Resources\Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\SoundMeeter.Audio\SoundMeeter.Audio.Contract.Implementation\SoundMeeter.Audio.Contract.Implementation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.ChangeLanguage\SoundMeeter.ChangeLanguage.Presentation\SoundMeeter.ChangeLanguage.Presentation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Core\SoundMeeter.Core.UseCases\SoundMeeter.Core.UseCases.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Core\SoundMeeter.Core.Presentation\SoundMeeter.Core.Presentation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Framework\SoundMeeter.Framework.Presentation\SoundMeeter.Framework.Presentation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Infrastructure\SoundMeeter.Infrastructure.Contract.Implementation\SoundMeeter.Infrastructure.Contract.Implementation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Midi\SoundMeeter.Midi.Presentation\SoundMeeter.Midi.Presentation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Midi\SoundMeeter.Midi.UseCases\SoundMeeter.Midi.UseCases.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Midi\SoundMeeter.Midi\SoundMeeter.Midi.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.TextToSpeech\SoundMeeter.TextToSpeech.UseCases\SoundMeeter.TextToSpeech.UseCases.csproj" />
    <!-- Композиционный корень регистрирует SAPI-реализации контрактов синтеза,
         каталога голосов и источника реплик. -->
    <ProjectReference Include="..\Modules\SoundMeeter.TextToSpeech\SoundMeeter.TextToSpeech.Contract.Implementation\SoundMeeter.TextToSpeech.Contract.Implementation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Twitch\SoundMeeter.Twitch.Presentation\SoundMeeter.Twitch.Presentation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Twitch\SoundMeeter.Twitch.UseCases\SoundMeeter.Twitch.UseCases.csproj" />
    <!-- Composition Root — единственное место, которое знает реализации контрактов
         Twitch: он и регистрирует их в контейнере. -->
    <ProjectReference Include="..\Modules\SoundMeeter.Twitch\SoundMeeter.Twitch.Contract.Implementation\SoundMeeter.Twitch.Contract.Implementation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Docking\SoundMeeter.Docking.UseCases\SoundMeeter.Docking.UseCases.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Docking\SoundMeeter.Docking.Presentation\SoundMeeter.Docking.Presentation.csproj" />
    <!-- Composition Root регистрирует сервер и установщик дока. -->
    <ProjectReference Include="..\Modules\SoundMeeter.Docking\SoundMeeter.Docking.Contract.Implementation\SoundMeeter.Docking.Contract.Implementation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.AppRouting\SoundMeeter.AppRouting.Contract.Implementation\SoundMeeter.AppRouting.Contract.Implementation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Twitch\SoundMeeter.Twitch\SoundMeeter.Twitch.csproj" />
    
    <ProjectReference Include="..\Modules\SoundMeeter.Update\SoundMeeter.Update.UseCases\SoundMeeter.Update.UseCases.csproj" />
    <!-- Composition Root регистрирует реализацию контракта обновления. -->
    <ProjectReference Include="..\Modules\SoundMeeter.Update\SoundMeeter.Update.Contract.Implementation\SoundMeeter.Update.Contract.Implementation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Update\SoundMeeter.Update.Presentation\SoundMeeter.Update.Presentation.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.StartUp\SoundMeeter.StartUp.UseCases\SoundMeeter.StartUp.UseCases.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.TrayIcon\SoundMeeter.TrayIcon.UseCases\SoundMeeter.TrayIcon.UseCases.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Infrastructure\SoundMeeter.Infrastructure.Settings\SoundMeeter.Infrastructure.Settings.csproj" />
    <ProjectReference Include="..\Modules\SoundMeeter.Infrastructure\SoundMeeter.Infrastructure.UiTimer\SoundMeeter.Infrastructure.UiTimer.csproj" />
    <ProjectReference Include="..\StreamerTools.Style\StreamerTools.Style.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SoundMeeter.App.Tests" />
  </ItemGroup>
</Project>


