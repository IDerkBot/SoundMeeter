<Window
    x:Class="SoundMeeter.Views.MidiBindingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Sm.Midi.Title}"
    Width="720"
    Height="560"
    MinWidth="640"
    MinHeight="400"
    Background="#1E1E1E"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#CCC"
                Text="{DynamicResource Sm.Midi.Input}" />
            <ComboBox
                Grid.Column="1"
                DisplayMemberPath="Name"
                ItemsSource="{Binding DeviceOptions}"
                SelectedItem="{Binding SelectedDevice}" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,8"
            Padding="8,4"
            Background="#2B2B2B"
            CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Foreground="#9A9A9A" Text="{DynamicResource Sm.Midi.Status}" />
                <TextBlock Foreground="#EEE" Text="{Binding Status}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel.Resources>
                    <Style x:Key="CellLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="Foreground" Value="#AAA" />
                        <Setter Property="TextAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="CellDisplay" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="TextAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,2,0,0" />
                        <Setter Property="Foreground" Value="#EEE" />
                    </Style>
                    <Style
                        x:Key="CellButton"
                        BasedOn="{StaticResource {x:Type Button}}"
                        TargetType="Button">
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="Margin" Value="0,4,4,0" />
                    </Style>
                    <Style x:Key="StripHeader" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="#DDD" />
                        <Setter Property="Margin" Value="0,10,0,6" />
                    </Style>
                </StackPanel.Resources>

                <ItemsControl ItemsSource="{Binding Strips}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StripHeader}" Text="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Params}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Width="132"
                                                Margin="0,0,6,6"
                                                Padding="6"
                                                VerticalAlignment="Top"
                                                Background="#262626"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="#9A9A9A"
                                                        Text="{Binding Descriptor.Label}"
                                                        TextAlignment="Center" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Text="{Binding Display, Mode=OneWay}"
                                                        TextAlignment="Center" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button
                                                            Grid.Column="0"
                                                            Command="{Binding LearnCommand}"
                                                            Content="{DynamicResource Sm.Midi.Learn}"
                                                            Style="{StaticResource CellButton}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Command="{Binding ClearCommand}"
                                                            Content="✕"
                                                            IsEnabled="{Binding IsBound}"
                                                            Style="{StaticResource CellButton}" />
                                                    </Grid>
                                                    <StackPanel
                                                        Margin="0,10,0,0"
                                                        HorizontalAlignment="Center"
                                                        Orientation="Vertical"
                                                        Visibility="{Binding IsButton, Converter={StaticResource BoolToVis}}">
                                                        <ComboBox
                                                            Width="114"
                                                            VerticalAlignment="Center"
                                                            DisplayMemberPath="Name"
                                                            FontSize="10"
                                                            ItemsSource="{Binding ModeOptions}"
                                                            SelectedValue="{Binding Mode}"
                                                            SelectedValuePath="Value"
                                                            ToolTip="{DynamicResource Sm.Midi.ModeTip}" />
                                                        <CheckBox
                                                            Margin="-0,6,0,0"
                                                            VerticalAlignment="Center"
                                                            Content="{DynamicResource Sm.Midi.Reverse}"
                                                            FontSize="10"
                                                            Foreground="#CCC"
                                                            IsChecked="{Binding IsInverted}"
                                                            Style="{StaticResource CheckBoxCompact}"
                                                            ToolTip="{DynamicResource Sm.Midi.ReverseTip}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="3"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Padding="18,5"
                Click="OnCloseClick"
                Content="{DynamicResource Sm.Midi.Close}"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>