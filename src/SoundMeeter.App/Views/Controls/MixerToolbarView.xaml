<UserControl
    x:Class="SoundMeeter.Views.Controls.MixerToolbarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="clr-namespace:StreamerTools.Style.Controls;assembly=StreamerTools.Style"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpf="clr-namespace:StreamerTools.Style.AttachedProperties;assembly=StreamerTools.Style"
    Margin="0,0,0,0"
    d:DesignHeight="44"
    d:DesignWidth="700"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <Button
            x:Name="SettingsBtn"
            Height="34"
            Margin="0,0,6,0"
            wpf:Button.LeftIcon="Cog"
            Click="OnSettingsClick"
            Content="{DynamicResource Sm.Toolbar.Settings}"
            ToolTip="{DynamicResource Sm.Toolbar.SettingsTip}" />
        <Button
            Height="34"
            Command="{Binding ToggleRunCommand}"
            Content="{Binding StartStopText}">
            <Button.Resources>
                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                    <Setter Property="wpf:Button.LeftIcon" Value="Play" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="wpf:Button.LeftIcon" Value="Stop" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Resources>
        </Button>
        <TextBlock
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Text="{Binding Status}" />
        <TextBlock
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Foreground="#7E9C7E"
            Text="{Binding UpdateStatus}" />

        <Popup
            x:Name="SettingsPopup"
            Width="240"
            AllowsTransparency="True"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=SettingsBtn}"
            StaysOpen="False">
            <Border
                Padding="4"
                Background="#2B2B2B"
                BorderBrush="#555"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel>
                    <Button
                        Click="OnMenuItemClick"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MenuRow}"
                        ToolTip="{DynamicResource Sm.Toolbar.RefreshDevicesTip}">
                        <StackPanel Orientation="Horizontal">
                            <icon:Icon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                Fill="#9A9A9A"
                                Kind="Refresh" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Sm.Toolbar.RefreshDevices}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="OnMidiClick"
                        Style="{StaticResource MenuRow}"
                        ToolTip="{DynamicResource Sm.Toolbar.MidiTip}">
                        <StackPanel Orientation="Horizontal">
                            <icon:Icon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                Fill="#9A9A9A"
                                Kind="Midi" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Sm.Toolbar.Midi}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="OnObsDockClick"
                        Style="{StaticResource MenuRow}"
                        ToolTip="{DynamicResource Sm.Toolbar.ObsDockTip}">
                        <StackPanel Orientation="Horizontal">
                            <icon:Icon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                Fill="#9A9A9A"
                                Kind="Monitor" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Sm.Toolbar.ObsDock}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="OnCheckUpdatesClick"
                        Style="{StaticResource MenuRow}"
                        ToolTip="{DynamicResource Sm.Toolbar.CheckUpdatesTip}">
                        <StackPanel Orientation="Horizontal">
                            <icon:Icon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                Fill="#9A9A9A"
                                Kind="CloudDownload" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Sm.Toolbar.CheckUpdates}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="OnLogsClick"
                        Style="{StaticResource MenuRow}"
                        ToolTip="{DynamicResource Sm.Toolbar.LogsTip}">
                        <StackPanel Orientation="Horizontal">
                            <icon:Icon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                Fill="#9A9A9A"
                                Kind="Text" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Sm.Toolbar.Logs}" />
                        </StackPanel>
                    </Button>

                    <Button
                        Click="OnExportSettingsClick"
                        Style="{StaticResource MenuRow}"
                        ToolTip="{DynamicResource Sm.Transfer.ExportTip}">
                        <StackPanel Orientation="Horizontal">
                            <icon:Icon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                Fill="#9A9A9A"
                                Kind="Export" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Sm.Transfer.Export}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="OnImportSettingsClick"
                        Style="{StaticResource MenuRow}"
                        ToolTip="{DynamicResource Sm.Transfer.ImportTip}">
                        <StackPanel Orientation="Horizontal">
                            <icon:Icon
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                Fill="#9A9A9A"
                                Kind="Import" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Sm.Transfer.Import}" />
                        </StackPanel>
                    </Button>

                    <!--
                        Переключатель языка (SM-C07). Отдельный подзаголовок, а
                        не шестой пункт меню: язык — настройка приложения, а не
                        действие над звуком, и он применяется сразу, без вопроса.
                    -->
                    <Border
                        Height="1"
                        Margin="4,6"
                        Background="#3F3F46" />
                    <TextBlock
                        Margin="8,0,0,2"
                        FontSize="10"
                        Foreground="#7C7C7C"
                        Text="{DynamicResource Sm.Language.Menu}"
                        ToolTip="{DynamicResource Sm.Language.MenuTip}" />
                    <ItemsControl ItemsSource="{Binding Languages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding SelectCommand}" Style="{StaticResource MenuRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Foreground="#7E9C7E"
                                            Text="✓"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Поведение приложения (SM-D01/SM-D02): значок в трее и
                        автозапуск вместе с Windows. Отдельная группа потому,
                        что это не действия над звуком, а то, как приложение
                        ведёт себя в системе: обе галочки применяются сразу и
                        без подтверждения, а отмена галочки «запускать
                        вместе с Windows» убирает запись из реестра.
                    -->
                    <Border
                        Height="1"
                        Margin="4,6"
                        Background="#3F3F46" />
                    <TextBlock
                        Margin="8,0,0,2"
                        FontSize="10"
                        Foreground="#7C7C7C"
                        Text="{DynamicResource Sm.Tray.Menu}" />
                    <CheckBox
                        Margin="6,0,0,0"
                        Content="{DynamicResource Sm.Tray.Enabled}"
                        IsChecked="{Binding TrayEnabled, Mode=TwoWay}"
                        ToolTip="{DynamicResource Sm.Tray.EnabledTip}" />
                    <CheckBox
                        Margin="6,2,0,0"
                        Content="{DynamicResource Sm.Tray.Startup}"
                        IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                        ToolTip="{DynamicResource Sm.Tray.StartupTip}" />
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>