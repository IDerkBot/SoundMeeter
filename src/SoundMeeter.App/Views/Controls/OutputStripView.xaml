<UserControl
    x:Class="SoundMeeter.Views.Controls.OutputStripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpf="clr-namespace:StreamerTools.Style.AttachedProperties;assembly=StreamerTools.Style"
    d:DesignHeight="400"
    d:DesignWidth="150"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
                <ResourceDictionary Source="/SoundMeeter;component/Style/StripToggleButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Layout стрипа выхода:
        - Имя канала сверху (редактируемое)
        - Имя устройства (кнопка выбора)
        - Meter+Fader слева, кнопки MONO/SOLO/MUTE справа вертикально
        - Громкость внизу
    -->
    <Border
        Width="150"
        Margin="0,0,10,6"
        Padding="6"
        VerticalAlignment="Top"
        Background="#3E3E42"
        CornerRadius="6"
        Opacity="{Binding IsAvailable, Converter={StaticResource BoolToOpacity}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Имя канала: сверху стрипа. ПКМ — переименовать, ЛКМ с протяжкой — перетащить.  -->
            <Border
                Grid.Row="0"
                Background="Transparent"
                PreviewMouseLeftButtonDown="OnStripDragStart"
                PreviewMouseMove="OnStripDragMove">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StripTitleTemplate}" />
            </Border>

            <!--  Имя устройства (кнопка выбора)  -->
            <Button
                Grid.Row="1"
                Height="22"
                Margin="0,2,0,4"
                Padding="0"
                HorizontalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="OnBusNameClick"
                Content="{Binding Name}"
                FontSize="9"
                FontWeight="Bold"
                Foreground="#808080"
                ToolTip="{DynamicResource Sm.Strip.ChooseOutputTip}" />

            <!--  Основной контент: Meter+Fader слева, кнопки справа  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Meter + Fader  -->
                <ContentControl
                    Grid.Column="0"
                    Height="260"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource MeterAndFader}" />

                <!--  Кнопки вертикально: MONO / SOLO / MUTE  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    VerticalAlignment="Top">
                    <ToggleButton
                        Margin="0,1"
                        Content="{DynamicResource Sm.Strip.Mono}"
                        IsChecked="{Binding IsMono}"
                        Style="{StaticResource StripBlueBtn}"
                        ToolTip="{DynamicResource Sm.Strip.MonoTip}" />

                    <ToggleButton
                        Margin="0,1"
                        Content="{DynamicResource Sm.Strip.Solo}"
                        IsChecked="{Binding IsSolo}"
                        Style="{StaticResource StripOrangeBtn}"
                        ToolTip="{DynamicResource Sm.Strip.SoloTip}" />

                    <ToggleButton
                        Margin="0,1"
                        Content="{DynamicResource Sm.Strip.Mute}"
                        IsChecked="{Binding IsMuted}"
                        Style="{StaticResource StripRedBtn}"
                        ToolTip="{DynamicResource Sm.Strip.MuteTip}" />
                </StackPanel>
            </Grid>

            <!--  Громкость  -->
            <TextBlock
                Grid.Row="3"
                Style="{StaticResource VolumeDisplay}"
                Text="{Binding VolumeDb, StringFormat={}{0:F1} dB}" />
        </Grid>
    </Border>
</UserControl>
