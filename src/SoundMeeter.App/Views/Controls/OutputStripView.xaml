<UserControl
    x:Class="SoundMeeter.Views.Controls.OutputStripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SoundMeeter.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpf="clr-namespace:StreamerTools.Style.AttachedProperties;assembly=StreamerTools.Style"
    d:DesignHeight="360"
    d:DesignWidth="138"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Width="150"
        Margin="0,0,10,6"
        Padding="6"
        Background="#3E3E42"
        CornerRadius="3"
        Opacity="{Binding IsAvailable, Converter={StaticResource BoolToOpacity}}">
        <StackPanel>
            <!--  Имя канала: сверху стрипа, над именем устройства. ПКМ — переименовать, ЛКМ с протяжкой — перетащить.  -->
            <Border
                Background="Transparent"
                PreviewMouseLeftButtonDown="OnStripDragStart"
                PreviewMouseMove="OnStripDragMove">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StripTitleTemplate}" />
            </Border>

            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                <Button
                    Width="18"
                    Height="26"
                    Margin="0"
                    Padding="0"
                    wpf:Button.Icon="Close"
                    wpf:Button.IconHeight="8"
                    wpf:Button.IconWidth="8"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnRemoveClick"
                    DockPanel.Dock="Right"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#AAA"
                    ToolTip="{DynamicResource Sm.Strip.RemoveTip}" />
                <Button
                    Height="26"
                    Padding="0"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnBusNameClick"
                    Content="{Binding Name}"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="White"
                    ToolTip="{DynamicResource Sm.Strip.ChooseOutputTip}" />
            </DockPanel>

            <UniformGrid Columns="2">
                <ContentControl
                    Height="420"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource MeterAndFader}" />
                <UniformGrid VerticalAlignment="Top" Rows="3">
                    <ToggleButton
                        Margin="2"
                        Content="{DynamicResource Sm.Strip.MonoShort}"
                        IsChecked="{Binding IsMono}"
                        Style="{StaticResource LedToggle}"
                        ToolTip="{DynamicResource Sm.Strip.MonoTip}" />
                    <ToggleButton
                        Margin="2"
                        Content="{DynamicResource Sm.Strip.SoloShort}"
                        IsChecked="{Binding IsSolo}"
                        Style="{StaticResource LedToggle}"
                        ToolTip="{DynamicResource Sm.Strip.SoloTip}" />
                    <ToggleButton
                        Margin="2"
                        Content="{DynamicResource Sm.Strip.Mute}"
                        IsChecked="{Binding IsMuted}"
                        Style="{StaticResource LedToggle}"
                        ToolTip="{DynamicResource Sm.Strip.MuteTip}" />
                </UniformGrid>
            </UniformGrid>

            <TextBlock
                Margin="0,2,0,4"
                HorizontalAlignment="Center"
                FontSize="10"
                Foreground="#AAA"
                Text="{Binding VolumeDb, StringFormat={}{0:F1} dB}" />


        </StackPanel>
    </Border>
</UserControl>