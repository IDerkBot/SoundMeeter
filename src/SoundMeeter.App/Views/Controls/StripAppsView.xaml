<UserControl
    x:Class="SoundMeeter.Views.Controls.StripAppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="clr-namespace:StreamerTools.Style.AttachedProperties;assembly=StreamerTools.Style"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SoundMeeter.Audio.Presentation.ViewModels;assembly=SoundMeeter.Audio.Presentation"
    d:DataContext="{d:DesignInstance vm:InputChannelViewModel}"
    d:DesignHeight="130"
    d:DesignWidth="126"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Высота не ограничена: панель забирает всё пустое место стрипа  -->
    <Border
        MinHeight="30"
        Background="#1a1a1a"
        CornerRadius="6">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="4"
                    FontSize="10"
                    Foreground="#AAA"
                    Text="{Binding AppDropHint}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding AssignedApps.Count}" Value="0" />
                                        <Condition Binding="{Binding ConfiguredApps.Count}" Value="0" />
                                    </MultiDataTrigger.Conditions>

                                    <MultiDataTrigger.Setters>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--  Активные приложения  -->
                <ItemsControl Margin="2,2,2,0" ItemsSource="{Binding AssignedApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2"
                                Padding="3"
                                Background="#3F3F46"
                                CornerRadius="4"
                                Cursor="Hand"
                                MouseLeftButtonDown="App_MouseLeftButtonDown"
                                PreviewMouseMove="App_PreviewMouseMove"
                                ToolTip="{Binding Name}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,3,0"
                                            Source="{Binding ProcessId, Converter={StaticResource ProcessIconConverter}}" />
                                        <TextBlock
                                            MaxWidth="160"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="#E0E0E0"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Width="16"
                                        Height="20"
                                        Padding="0"
                                        attachedProperties:Button.Icon="Close"
                                        attachedProperties:Button.IconHeight="8"
                                        attachedProperties:Button.IconWidth="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveStripApp_Click"
                                        Cursor="Hand"
                                        Foreground="#D54343"
                                        ToolTip="{DynamicResource Sm.StripApps.ResetTip}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Ожидающие запуска приложения (Wave Link style)  -->
                <ItemsControl Margin="2,2,2,0" ItemsSource="{Binding ConfiguredApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2"
                                Padding="3"
                                Background="#2D2D30"
                                BorderBrush="#555555"
                                BorderThickness="1"
                                CornerRadius="4"
                                Cursor="Hand"
                                MouseLeftButtonDown="App_MouseLeftButtonDown"
                                Opacity="0.7"
                                PreviewMouseMove="App_PreviewMouseMove"
                                ToolTip="{Binding ExecutablePath}">
                                <DockPanel>
                                    <Button
                                        Width="16"
                                        Height="20"
                                        Padding="0"
                                        attachedProperties:Button.Icon="Close"
                                        attachedProperties:Button.IconHeight="8"
                                        attachedProperties:Button.IconWidth="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveStripApp_Click"
                                        Cursor="Hand"
                                        DockPanel.Dock="Right"
                                        Foreground="#D54343"
                                        ToolTip="{DynamicResource Sm.StripApps.RemoveRuleTip}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,3,0"
                                            Source="{Binding IconPath, Converter={StaticResource FileIconConverter}}" />
                                        <TextBlock
                                            MaxWidth="160"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="#A0A0A0"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
