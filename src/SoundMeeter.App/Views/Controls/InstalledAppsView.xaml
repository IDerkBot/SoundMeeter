<UserControl
    x:Class="SoundMeeter.Views.Controls.InstalledAppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="clr-namespace:StreamerTools.Style.Controls;assembly=StreamerTools.Style"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Margin="5,0,0,0"
        Padding="12"
        Background="#252526"
        CornerRadius="8">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{DynamicResource Sm.Apps.Installed}" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <!--  Search box с иконкой  -->
                    <Border
                        Width="250"
                        Margin="0,0,10,0"
                        Background="#3F3F46"
                        CornerRadius="4">
                        <DockPanel>
                            <icon:Icon
                                Width="14"
                                Height="14"
                                Margin="8,0,0,0"
                                DockPanel.Dock="Left"
                                Fill="#808080"
                                Kind="Search" />
                            <TextBox
                                Margin="4,0,8,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource SearchTextBox}"
                                Tag="{DynamicResource Sm.Apps.SearchHint}"
                                Text="{Binding InstalledAppsSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>

                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding LoadInstalledAppsCommand}"
                        Content="{DynamicResource Sm.Apps.Refresh}"
                        IsEnabled="{Binding IsLoadingInstalledApps, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>
            </DockPanel>

            <!--  Индикатор загрузки  -->
            <TextBlock
                Margin="10,10,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="14"
                Foreground="#808080"
                Text="{DynamicResource Sm.Apps.Loading}"
                Visibility="{Binding IsLoadingInstalledApps, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding IsLoadingInstalledApps, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding FilteredInstalledApps}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="80"
                                Margin="3"
                                Padding="8"
                                Background="#2D2D30"
                                BorderBrush="#3F3F46"
                                BorderThickness="1"
                                CornerRadius="6"
                                Cursor="Hand"
                                MouseLeftButtonDown="App_MouseLeftButtonDown"
                                PreviewMouseMove="App_PreviewMouseMove"
                                Style="{StaticResource AppCard}"
                                ToolTip="{Binding Publisher}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Image
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,0,4"
                                        HorizontalAlignment="Center"
                                        Source="{Binding IconPath, Converter={StaticResource FileIconConverter}}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="White"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
