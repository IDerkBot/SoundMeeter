<UserControl
    x:Class="SoundMeeter.Views.Controls.StripEffectSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="260"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Параметры эффекта стрипа (SM-B05). Список крутилок приходит данными
        (StripEffectViewModel.Knobs), поэтому один попап обслуживает и
        компрессор, и задержку, и реверберацию: новый эффект не требует
        разметки. Ширина попапа под 3 крутилки в ряд.
        DataContext — StripEffectViewModel.
    -->
    <Border
        Padding="6"
        Background="#2B2B2B"
        BorderBrush="#555"
        BorderThickness="1"
        CornerRadius="3">
        <StackPanel Width="250">
            <TextBlock
                FontSize="10"
                FontWeight="Bold"
                Text="{Binding Title}"
                ToolTip="{Binding ToolTip}" />

            <ItemsControl Margin="0,6,0,0" ItemTemplate="{StaticResource EffectKnobTemplate}" ItemsSource="{Binding Knobs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock
                Margin="0,6,0,0"
                FontSize="9"
                Foreground="#7FB8D8"
                Text="{DynamicResource Sm.Effect.Hint}"
                TextWrapping="Wrap"
                Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
