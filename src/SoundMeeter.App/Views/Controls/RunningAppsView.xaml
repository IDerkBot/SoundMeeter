<UserControl
    x:Class="SoundMeeter.Views.Controls.RunningAppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="10">
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{DynamicResource Sm.Apps.WithAudio}" />

                <Button
                    HorizontalAlignment="Right"
                    Command="{Binding RefreshDataCommand}"
                    Content="{DynamicResource Sm.Apps.Refresh}" />
            </Grid>

            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RunningApps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                MouseLeftButtonDown="App_MouseLeftButtonDown"
                                PreviewMouseMove="App_PreviewMouseMove"
                                Style="{StaticResource AppCard}">
                                <StackPanel
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal">
                                    <Image
                                        Width="28"
                                        Height="28"
                                        Source="{Binding ProcessId, Converter={StaticResource ProcessIconConverter}}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Code"
                                        FontSize="10"
                                        FontWeight="Regular"
                                        Foreground="White"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="WrapWithOverflow" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
