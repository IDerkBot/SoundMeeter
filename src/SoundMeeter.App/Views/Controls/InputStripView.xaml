<UserControl
    x:Class="SoundMeeter.Views.Controls.InputStripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SoundMeeter.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:panels="clr-namespace:SoundMeeter.Controls"
    xmlns:strip="clr-namespace:SoundMeeter.Views.Controls"
    d:DesignWidth="160"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Строчный план: заголовок, имя источника, метры (их высота фиксирована
        дизайном) и выбор выхода — всё по содержимому, а панель приложений
        забирает оставшуюся высоту стрипа.
    -->
    <Border
        Width="138"
        Margin="0,0,10,6"
        Padding="6"
        AllowDrop="True"
        CornerRadius="3"
        DragEnter="Device_DragEnter"
        DragLeave="Device_DragLeave"
        DragOver="Device_DragEnter"
        Drop="Device_Drop">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#3E3E42" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                        <Setter Property="BorderBrush" Value="#4FC3F7" />
                        <Setter Property="Background" Value="#354B58" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Имя канала: сверху стрипа, над именем устройства. ПКМ — переименовать,
                ЛКМ с протяжкой — перетащить стрип на другое место (SM-C06).
            -->
            <Border
                Grid.Row="0"
                Background="Transparent"
                PreviewMouseLeftButtonDown="OnStripDragStart"
                PreviewMouseMove="OnStripDragMove">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StripTitleTemplate}" />
            </Border>

            <DockPanel
                Grid.Row="1"
                Margin="0,0,0,4"
                LastChildFill="True">
                <Button
                    Width="18"
                    Height="18"
                    Margin="4,0,0,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnRemoveClick"
                    Content="×"
                    DockPanel.Dock="Right"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#AAA"
                    ToolTip="{DynamicResource Sm.Strip.RemoveTip}" />
                <Button
                    Padding="0"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnInputNameClick"
                    Content="{Binding Name}"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="White"
                    ToolTip="{DynamicResource Sm.Strip.ChooseInputTip}" />
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl
                    Grid.Row="0"
                    Grid.Column="0"
                    Height="200"
                    VerticalAlignment="Top"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource MeterAndFader}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,2,0,4"
                    HorizontalAlignment="Center"
                    FontSize="10"
                    Foreground="#AAA"
                    Text="{Binding VolumeDb, StringFormat={}{0:F1} dB}" />

<!--
                    Колонка кнопок стрипа: маршрутизация и состояние (слева в
                    этом списке), ниже — две кнопки FUNC и сетка эффектов 2×2.
                    Всё в одной колонке, поэтому ряды не наезжают друг на друга,
                    а полоса растёт вниз по мере надобности.
                -->
                <StackPanel
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    VerticalAlignment="Top">
                    <UniformGrid Columns="1">
                    <Button
                        x:Name="OutBtn"
                        Margin="2"
                        Click="OnOutClick"
                        Content="{Binding OutButtonText}"
                        IsEnabled="{Binding HasHardware}"
                        Style="{StaticResource RouteBtn}"
                        ToolTip="{DynamicResource Sm.Strip.HardwareOutputsTip}" />
                    <Button
                        x:Name="VirtBtn"
                        Margin="2"
                        Click="OnVirtClick"
                        Content="{Binding VirtButtonText}"
                        IsEnabled="{Binding HasVirtual}"
                        Style="{StaticResource RouteBtn}"
                        ToolTip="{DynamicResource Sm.Strip.VirtualOutputsTip}" />
                    <ToggleButton
                        Margin="2"
                        Content="{DynamicResource Sm.Strip.Mono}"
                        IsChecked="{Binding IsMono}"
                        Style="{StaticResource LedToggle}"
                        ToolTip="{DynamicResource Sm.Strip.MonoTip}" />
                    <ToggleButton
                        Margin="2"
                        Content="{DynamicResource Sm.Strip.Solo}"
                        IsChecked="{Binding IsSolo}"
                        Style="{StaticResource LedToggle}"
                        ToolTip="{DynamicResource Sm.Strip.SoloTip}" />
                    <ToggleButton
                        Margin="2"
                        Content="{DynamicResource Sm.Strip.Mute}"
                        IsChecked="{Binding IsMuted}"
                        Style="{StaticResource LedToggle}"
                        ToolTip="{DynamicResource Sm.Strip.MuteTip}" />
                    <ToggleButton
                        x:Name="DenBtn"
                        Margin="2"
                        Content="{DynamicResource Sm.Strip.Denoiser}"
                        IsChecked="{Binding DenoiserEnabled}"
                        MouseRightButtonUp="OnDenRightClick"
                        Style="{StaticResource LedToggle}"
                        ToolTip="{DynamicResource Sm.Strip.DenoiserTip}" />

                    <!--
                        Кнопки FUNC — переключатели: нажатие применяет
                        назначенные выходы к роутингу стрипа, повторное снимает
                        и возвращает прежний. ПКМ — назначение (попап).

                        Кнопку без назначения отключать нельзя: у отключённого
                        элемента не приходит ПКМ, и назначить выходы было бы
                        уже нечем (попап открывает только она). Вместо этого
                        приглушаем её, а нажатие такой кнопки открывает попап
                        назначения (OnFuncClick).

                        Обёртка нужна ради DataContext: привязки идут к
                        FuncButtonViewModel, а не к стрипу.
                    -->
                    <Grid DataContext="{Binding Func1}">
                        <ToggleButton
                            x:Name="Func1Btn"
                            Margin="2"
                            Click="OnFuncClick"
                            Content="{Binding ButtonText}"
                            IsChecked="{Binding IsEngaged, Mode=TwoWay}"
                            MouseRightButtonUp="OnFuncRightClick"
                            Opacity="{Binding ButtonOpacity}"
                            Style="{StaticResource FuncBtn}"
                            ToolTip="{Binding ToolTip}" />
                    </Grid>
                    <Grid DataContext="{Binding Func2}">
                        <ToggleButton
                            x:Name="Func2Btn"
                            Margin="2"
                            Click="OnFuncClick"
                            Content="{Binding ButtonText}"
                            IsChecked="{Binding IsEngaged, Mode=TwoWay}"
                            MouseRightButtonUp="OnFuncRightClick"
                            Opacity="{Binding ButtonOpacity}"
                            Style="{StaticResource FuncBtn}"
                            ToolTip="{Binding ToolTip}" />
                    </Grid>
                    </UniformGrid>

                <!--
                    Эффекты стрипа (SM-B05): компрессор, trim, задержка,
                    реверберация. Сетка 2×2, чтобы колонка кнопок не выросла на
                    четыре ряда: кнопки узкие, подписи в две буквы. ЛКМ — вкл/выкл,
                    ПКМ — попап с крутилками.
                -->
                <UniformGrid Margin="0,4,0,0" Columns="2">
                    <Grid DataContext="{Binding Compressor}">
                        <ToggleButton
                            x:Name="CompressorBtn"
                            Margin="2"
                            Content="{Binding ButtonText}"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                            MouseRightButtonUp="OnEffectRightClick"
                            Style="{StaticResource EffectBtn}"
                            ToolTip="{Binding ToolTip}" />
                    </Grid>
                    <Grid DataContext="{Binding FxGain}">
                        <ToggleButton
                            x:Name="FxGainBtn"
                            Margin="2"
                            Content="{Binding ButtonText}"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                            MouseRightButtonUp="OnEffectRightClick"
                            Style="{StaticResource EffectBtn}"
                            ToolTip="{Binding ToolTip}" />
                    </Grid>
                    <Grid DataContext="{Binding Delay}">
                        <ToggleButton
                            x:Name="DelayBtn"
                            Margin="2"
                            Content="{Binding ButtonText}"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                            MouseRightButtonUp="OnEffectRightClick"
                            Style="{StaticResource EffectBtn}"
                            ToolTip="{Binding ToolTip}" />
                    </Grid>
                    <Grid DataContext="{Binding Reverb}">
                        <ToggleButton
                            x:Name="ReverbBtn"
                            Margin="2"
                            Content="{Binding ButtonText}"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                            MouseRightButtonUp="OnEffectRightClick"
                            Style="{StaticResource EffectBtn}"
                            ToolTip="{Binding ToolTip}" />
                    </Grid>
                    </UniformGrid>
                </StackPanel>

                <Popup
                    x:Name="OutPopup"
                    Width="272"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=OutBtn}"
                    StaysOpen="False">
                    <Border
                        Padding="6"
                        Background="#2B2B2B"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="3">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{DynamicResource Sm.Strip.HardwareOutputs}" />
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemTemplate="{StaticResource OutputOptionTemplate}" ItemsSource="{Binding HardwareOutputs}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup
                    x:Name="VirtPopup"
                    Width="272"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=VirtBtn}"
                    StaysOpen="False">
                    <Border
                        Padding="6"
                        Background="#2B2B2B"
                        BorderBrush="#555"
                        BorderThickness="1"
                        CornerRadius="3">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="10"
                                FontWeight="Bold"
                                Text="{DynamicResource Sm.Strip.VirtualOutputs}" />
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemTemplate="{StaticResource OutputOptionTemplate}" ItemsSource="{Binding VirtualOutputs}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup
                    x:Name="DenPopup"
                    Width="272"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=DenBtn}"
                    StaysOpen="False">
                    <controls:DenoiserSettingsView />
                </Popup>

                <Popup
                    x:Name="Func1Popup"
                    Width="272"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=Func1Btn}"
                    StaysOpen="False">
                    <controls:FuncButtonSettingsView x:Name="Func1View" DataContext="{Binding Func1}" />
                </Popup>

                <Popup
                    x:Name="Func2Popup"
                    Width="272"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=Func2Btn}"
                    StaysOpen="False">
                    <controls:FuncButtonSettingsView x:Name="Func2View" DataContext="{Binding Func2}" />
                </Popup>

                <Popup
                    x:Name="CompressorPopup"
                    Width="272"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=CompressorBtn}"
                    StaysOpen="False">
                    <controls:StripEffectSettingsView DataContext="{Binding Compressor}" />
                </Popup>

                <Popup
                    x:Name="FxGainPopup"
                    Width="272"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=FxGainBtn}"
                    StaysOpen="False">
                    <controls:StripEffectSettingsView DataContext="{Binding FxGain}" />
                </Popup>

                <Popup
                    x:Name="DelayPopup"
                    Width="272"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=DelayBtn}"
                    StaysOpen="False">
                    <controls:StripEffectSettingsView DataContext="{Binding Delay}" />
                </Popup>

                <Popup
                    x:Name="ReverbPopup"
                    Width="272"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=ReverbBtn}"
                    StaysOpen="False">
                    <controls:StripEffectSettingsView DataContext="{Binding Reverb}" />
                </Popup>
            </Grid>

            <!--
                Куда уходят приложения канала: над блоком приложений, а не внутри
                него — список прокручивается, а этот выбор нужен постоянно. Показывается
                только у входа виртуального кабеля: его выход движок обычно определяет
                сам, но имя кабеля задаёт пользователь, поэтому нужен и ручной выбор.
            -->
            <Button
                Grid.Row="3"
                Margin="0,4,0,2"
                Padding="2,3"
                Click="OnAppTargetClick"
                Content="{Binding AppTargetText}"
                FontSize="9"
                Style="{StaticResource RouteBtn}"
                ToolTip="{DynamicResource Sm.Strip.AppTargetTip}"
                Visibility="{Binding CanChooseAppTarget, Converter={StaticResource BoolToVisibility}}" />

            <controls:StripAppsView Grid.Row="4" Visibility="{Binding ShowAppList, Converter={StaticResource BoolToVisibility}}" />

            <!--
                На стрипе микрофона вместо списка приложений — входное усиление:
                приложения в микрофон не уходят (список был бы всегда пустым), а
                тихий сигнал микрофона без подъёма вверх не вытянуть.
            -->
            <StackPanel
                Grid.Row="4"
                Margin="0,8,0,0"
                VerticalAlignment="Center"
                Visibility="{Binding ShowGainKnob, Converter={StaticResource BoolToVisibility}}">
                <panels:GainKnob
                    Width="86"
                    Height="86"
                    HorizontalAlignment="Center"
                    Maximum="60"
                    ToolTip="{DynamicResource Sm.Strip.GainTip}"
                    Value="{Binding GainDb, Mode=TwoWay}"
                    strip:ParamReset.Command="{Binding ResetGainCommand}" />
                <TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="#EEE"
                    Text="{Binding GainDb, StringFormat={}{0:F1} dB}" />
                <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    FontSize="9"
                    Foreground="#808080"
                    Text="{DynamicResource Sm.Strip.GainLabel}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>