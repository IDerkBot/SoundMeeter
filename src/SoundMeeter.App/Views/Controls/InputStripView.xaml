<UserControl
    x:Class="SoundMeeter.Views.Controls.InputStripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SoundMeeter.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:strip="clr-namespace:SoundMeeter.Framework.Presentation.Controls;assembly=SoundMeeter.Framework.Presentation"
    xmlns:vm="clr-namespace:SoundMeeter.Audio.Presentation.ViewModels;assembly=SoundMeeter.Audio.Presentation"
    xmlns:wpf="clr-namespace:StreamerTools.Style.AttachedProperties;assembly=StreamerTools.Style"
    d:DataContext="{d:DesignInstance vm:InputChannelViewModel}"
    d:DesignWidth="150"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
                <ResourceDictionary Source="/SoundMeeter;component/Style/StripToggleButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Новый layout стрипа по наброску:
        - Имя канала сверху
        - Имя устройства под ним
        - Кнопки маршрутизации горизонтально
        - Meter+Fader слева, кнопки вертикально справа
        - Громкость внизу
        - GainKnob (микрофон) или список приложений (виртуальный вход) — под стрипом
    -->
    <Border
        Width="150"
        Margin="0,0,10,6"
        Padding="6"
        AllowDrop="True"
        CornerRadius="6"
        DragEnter="Device_DragEnter"
        DragLeave="Device_DragLeave"
        DragOver="Device_DragEnter"
        Drop="Device_Drop">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#3E3E42" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                        <Setter Property="BorderBrush" Value="#4FC3F7" />
                        <Setter Property="Background" Value="#354B58" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Имя канала: сверху стрипа. ПКМ — переименовать, ЛКМ с протяжкой — перетащить.  -->
            <Border
                Grid.Row="0"
                Background="Transparent"
                MouseLeftButtonDown="OnTitleMouseDown"
                MouseRightButtonUp="OnTitleRightClick">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StripTitleTemplate}" />
            </Border>

            <!--  Имя устройства  -->
            <Button
                Grid.Row="1"
                Height="22"
                Padding="0"
                HorizontalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="OnInputNameClick"
                Content="{Binding Name}"
                FontSize="9"
                FontWeight="Bold"
                Foreground="White"
                ToolTip="{DynamicResource Sm.Strip.ChooseInputTip}" />

            <!--  Основной контент: Meter+Fader слева, кнопки справа  -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Meter + Fader  -->
                <ContentControl
                    Grid.Column="0"
                    Height="260"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource MeterAndFader}" />

                <!--  Кнопки вертикально  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    VerticalAlignment="Top">
                    <Button
                        x:Name="OutBtn"
                        Click="OnOutClick"
                        IsEnabled="{Binding HasHardware}"
                        Style="{StaticResource RouteBtnCompact}"
                        ToolTip="{DynamicResource Sm.Strip.HardwareOutputsTip}">
                        <Button.Content>
                            <Grid Width="52">
                                <TextBlock HorizontalAlignment="Left" Text="OUT" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding OutButtonText}" />
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="VirtBtn"
                        Click="OnVirtClick"
                        IsEnabled="{Binding HasVirtual}"
                        Style="{StaticResource RouteBtnCompact}"
                        ToolTip="{DynamicResource Sm.Strip.VirtualOutputsTip}">
                        <Button.Content>
                            <Grid Width="52">
                                <TextBlock HorizontalAlignment="Left" Text="OUT" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding VirtButtonText}" />
                            </Grid>
                        </Button.Content>
                    </Button>
                    <ToggleButton
                        Content="{DynamicResource Sm.Strip.Mono}"
                        IsChecked="{Binding IsMono}"
                        Style="{StaticResource StripBlueBtn}"
                        ToolTip="{DynamicResource Sm.Strip.MonoTip}" />

                    <ToggleButton
                        Content="{DynamicResource Sm.Strip.Solo}"
                        IsChecked="{Binding IsSolo}"
                        Style="{StaticResource StripOrangeBtn}"
                        ToolTip="{DynamicResource Sm.Strip.SoloTip}" />

                    <ToggleButton
                        Content="{DynamicResource Sm.Strip.Mute}"
                        IsChecked="{Binding IsMuted}"
                        Style="{StaticResource StripRedBtn}"
                        ToolTip="{DynamicResource Sm.Strip.MuteTip}" />

                    <ToggleButton
                        x:Name="DenBtn"
                        Content="{DynamicResource Sm.Strip.Denoiser}"
                        IsChecked="{Binding DenoiserEnabled}"
                        MouseRightButtonUp="OnDenRightClick"
                        Style="{StaticResource StripPurpleBtn}"
                        ToolTip="{DynamicResource Sm.Strip.DenoiserTip}" />

                    <!--  FUNC1  -->
                    <Grid DataContext="{Binding Func1}">
                        <ToggleButton
                            x:Name="Func1Btn"
                            Margin="0,1"
                            Click="OnFuncClick"
                            Content="{Binding ButtonText}"
                            IsChecked="{Binding IsEngaged, Mode=TwoWay}"
                            MouseRightButtonUp="OnFuncRightClick"
                            Opacity="{Binding ButtonOpacity}"
                            Style="{StaticResource StripWhiteBtn}"
                            ToolTip="{Binding ToolTip}" />
                    </Grid>

                    <!--  FUNC2  -->
                    <Grid DataContext="{Binding Func2}">
                        <ToggleButton
                            x:Name="Func2Btn"
                            Margin="0,1"
                            Click="OnFuncClick"
                            Content="{Binding ButtonText}"
                            IsChecked="{Binding IsEngaged, Mode=TwoWay}"
                            MouseRightButtonUp="OnFuncRightClick"
                            Opacity="{Binding ButtonOpacity}"
                            Style="{StaticResource StripWhiteBtn}"
                            ToolTip="{Binding ToolTip}" />
                    </Grid>

                    <!--  Кнопка меню эффектов ()  -->
                    <Button
                        x:Name="MenuBtn"
                        Width="64"
                        Height="24"
                        Margin="0,4,0,0"
                        Padding="0"
                        wpf:Button.Icon="ReorderHorizontal"
                        wpf:Hint.CornerRadius="3"
                        Background="#3A3A3D"
                        BorderBrush="#555"
                        BorderThickness="1"
                        Click="OnMenuClick"
                        Foreground="White"
                        ToolTip="Эффекты" />
                </StackPanel>
            </Grid>

            <!--  Громкость  -->
            <TextBlock
                Grid.Row="4"
                Style="{StaticResource VolumeDisplay}"
                Text="{Binding VolumeDb, StringFormat={}{0:F1} dB}" />

            <!--  AppTarget (выбор устройства для приложений)  -->
            <Border
                Grid.Row="5"
                Margin="0,10,0,0"
                Background="#1a1a1a"
                CornerRadius="6"
                Visibility="{Binding CanChooseAppTarget, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Button
                        Width="118"
                        Height="20"
                        Margin="0,0,0,4"
                        Padding="0"
                        VerticalAlignment="Top"
                        wpf:Button.IconHeight="8"
                        wpf:Button.IconStrokeColor="White"
                        wpf:Button.IconWidth="10"
                        wpf:Button.LeftIcon="MenuRight"
                        wpf:Button.RightIcon="MenuLeft"
                        wpf:Hint.CornerRadius="0"
                        Background="Transparent"
                        BorderBrush="#555555"
                        BorderThickness="0,0,0,1"
                        Click="OnAppTargetClick"
                        Content="{Binding AppTargetText}"
                        FontSize="10"
                        Foreground="White"
                        ToolTip="{DynamicResource Sm.Strip.AppTargetTip}" />

                    <!--  Список приложений  -->
                    <controls:StripAppsView VerticalAlignment="Bottom" Visibility="{Binding ShowAppList, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!--  GainKnob (для микрофона) или список приложений  -->
            <Grid Grid.Row="5" VerticalAlignment="Bottom">
                <!--  GainKnob: только для микрофона  -->
                <StackPanel
                    Margin="0,4,0,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowGainKnob, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <strip:GainKnob
                            Width="86"
                            Height="86"
                            HorizontalAlignment="Center"
                            strip:ParamReset.Command="{Binding ResetGainCommand}"
                            Maximum="60"
                            TextFontSize="11"
                            TextForeground="#EEE"
                            TextFormat="{}{0:F1} dB"
                            ToolTip="{DynamicResource Sm.Strip.GainTip}"
                            Value="{Binding GainDb, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        FontSize="9"
                        Foreground="#808080"
                        Text="{DynamicResource Sm.Strip.GainLabel}" />
                </StackPanel>
            </Grid>

            <!--  Popup: OUT  -->
            <Popup
                x:Name="OutPopup"
                Width="272"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=OutBtn}"
                StaysOpen="False">
                <Border
                    Padding="6"
                    Background="#2B2B2B"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="3">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{DynamicResource Sm.Strip.HardwareOutputs}" />
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemTemplate="{StaticResource OutputOptionTemplate}" ItemsSource="{Binding HardwareOutputs}" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>

            <!--  Popup: VIRT  -->
            <Popup
                x:Name="VirtPopup"
                Width="272"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=VirtBtn}"
                StaysOpen="False">
                <Border
                    Padding="6"
                    Background="#2B2B2B"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="3">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="10"
                            FontWeight="Bold"
                            Text="{DynamicResource Sm.Strip.VirtualOutputs}" />
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemTemplate="{StaticResource OutputOptionTemplate}" ItemsSource="{Binding VirtualOutputs}" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>

            <!--  Popup: Denoiser  -->
            <Popup
                x:Name="DenPopup"
                Width="272"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=DenBtn}"
                StaysOpen="False">
                <controls:DenoiserSettingsView />
            </Popup>

            <!--  Popup: FUNC1  -->
            <Popup
                x:Name="Func1Popup"
                Width="272"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=Func1Btn}"
                StaysOpen="False">
                <controls:FuncButtonSettingsView x:Name="Func1View" DataContext="{Binding Func1}" />
            </Popup>

            <!--  Popup: FUNC2  -->
            <Popup
                x:Name="Func2Popup"
                Width="272"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=Func2Btn}"
                StaysOpen="False">
                <controls:FuncButtonSettingsView x:Name="Func2View" DataContext="{Binding Func2}" />
            </Popup>

            <!--  Popup: Effects menu ()  -->
            <Popup
                x:Name="EffectsPopup"
                Width="272"
                AllowsTransparency="True"
                Placement="Left"
                PlacementTarget="{Binding ElementName=MenuBtn}"
                StaysOpen="False">
                <Border
                    Padding="6"
                    Background="#2B2B2B"
                    BorderBrush="#555"
                    BorderThickness="1"
                    CornerRadius="3">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#9A9A9A"
                            Text="Эффекты" />

                        <!--  Compressor  -->
                        <Grid DataContext="{Binding Compressor}">
                            <ToggleButton
                                x:Name="CompressorBtn"
                                Margin="0,2"
                                Content="{Binding ButtonText}"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                MouseRightButtonUp="OnEffectRightClick"
                                Style="{StaticResource EffectBtn}"
                                ToolTip="{Binding ToolTip}" />
                        </Grid>

                        <!--  FxGain  -->
                        <Grid DataContext="{Binding FxGain}">
                            <ToggleButton
                                x:Name="FxGainBtn"
                                Margin="0,2"
                                Content="{Binding ButtonText}"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                MouseRightButtonUp="OnEffectRightClick"
                                Style="{StaticResource EffectBtn}"
                                ToolTip="{Binding ToolTip}" />
                        </Grid>

                        <!--  Delay  -->
                        <Grid DataContext="{Binding Delay}">
                            <ToggleButton
                                x:Name="DelayBtn"
                                Margin="0,2"
                                Content="{Binding ButtonText}"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                MouseRightButtonUp="OnEffectRightClick"
                                Style="{StaticResource EffectBtn}"
                                ToolTip="{Binding ToolTip}" />
                        </Grid>

                        <!--  Reverb  -->
                        <Grid DataContext="{Binding Reverb}">
                            <ToggleButton
                                x:Name="ReverbBtn"
                                Margin="0,2"
                                Content="{Binding ButtonText}"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                MouseRightButtonUp="OnEffectRightClick"
                                Style="{StaticResource EffectBtn}"
                                ToolTip="{Binding ToolTip}" />
                        </Grid>

                        <Border
                            Height="1"
                            Margin="0,4"
                            Background="#3F3F46" />

                        <!--  EQ (отдельное окно)  -->
                        <Grid DataContext="{Binding Equalizer}">
                            <ToggleButton
                                x:Name="EqBtn"
                                Margin="0,2"
                                Content="{Binding ButtonText}"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                MouseRightButtonUp="OnEqRightClick"
                                Style="{StaticResource EffectBtn}"
                                ToolTip="{Binding ToolTip}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>

            <!--  Popup: Compressor settings  -->
            <Popup
                x:Name="CompressorPopup"
                Width="272"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=CompressorBtn}"
                StaysOpen="False">
                <controls:StripEffectSettingsView DataContext="{Binding Compressor}" />
            </Popup>

            <!--  Popup: FxGain settings  -->
            <Popup
                x:Name="FxGainPopup"
                Width="272"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=FxGainBtn}"
                StaysOpen="False">
                <controls:StripEffectSettingsView DataContext="{Binding FxGain}" />
            </Popup>

            <!--  Popup: Delay settings  -->
            <Popup
                x:Name="DelayPopup"
                Width="272"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=DelayBtn}"
                StaysOpen="False">
                <controls:StripEffectSettingsView DataContext="{Binding Delay}" />
            </Popup>

            <!--  Popup: Reverb settings  -->
            <Popup
                x:Name="ReverbPopup"
                Width="272"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=ReverbBtn}"
                StaysOpen="False">
                <controls:StripEffectSettingsView DataContext="{Binding Reverb}" />
            </Popup>
        </Grid>
    </Border>
</UserControl>
