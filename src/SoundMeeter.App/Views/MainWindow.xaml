<Window
    x:Class="SoundMeeter.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SoundMeeter.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SoundMeeter.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
    Title="SoundMeeter"
    Width="1280"
    Height="1000"
    MinWidth="900"
    MinHeight="600"
    Background="#1E1E1E"
    SourceInitialized="Window_SourceInitialized"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <!--
        Кастомный chrome: WindowStyle=None + WindowChrome для нативного Aero Snap.
        WM_GETMINMAXINFO hook корректирует размеры максимизированного окна,
        чтобы контент не уходил за пределы экрана.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            CornerRadius="8"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="#1E1E1E" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Кастомный title bar  -->
            <controls:TitleBarView x:Name="TitleBar" Grid.Row="0" />

            <!--  Основной контент  -->
            <local:MainView Grid.Row="1" DataContext="{Binding}" />
        </Grid>
    </Border>
</Window>
