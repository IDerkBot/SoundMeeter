<Window
    x:Class="SoundMeeter.Views.EqualizerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SoundMeeter.Controls"
    Title="{Binding Title}"
    Width="960"
    Height="470"
    MinWidth="940"
    MinHeight="660"
    Background="#1E1E1E"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <!--
        Настройки эквалайзера стрипа (SM-B05). Отдельное окно, а не попап стрипа:
        десять полос с кривой не помещаются в 272 px, а окно можно оставить
        открытым и свернуть микшер — правка слышна сразу, движок не перезапускается.
        
        Модесное (Show, не ShowDialog) намеренно: пока окно открыто, стрип играет,
        иначе настраивать эквалайзер пришлось бы вслепую.
        
        DataContext — EqualizerViewModel.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="GroupLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#9A9A9A" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок: имя канала и выбор пресета кривой  -->
        <Grid Grid.Row="0">
            <StackPanel Margin="0,0,200,0">
                <TextBlock
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding ChannelTitle}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="10"
                    Foreground="#8C8C8C"
                    Text="{DynamicResource Sm.Eq.Hint}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--
                Список пресетов. Ширина подобрана под самый длинный перевод:
                иначе длинная подпись обрезается, а обрезанное имя пресета
                читается как другая кривая.
            -->
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <TextBlock
                    Margin="4,0,8,4"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#9A9A9A"
                    Text="{DynamicResource Sm.Eq.Preset}" />
                <ComboBox
                    Width="170"
                    VerticalContentAlignment="Center"
                    DisplayMemberPath="Name"
                    IsEditable="False"
                    ItemsSource="{Binding Presets}"
                    SelectedItem="{Binding SelectedPreset}"
                    ToolTip="{DynamicResource Sm.Eq.PresetTip}" />
            </StackPanel>
        </Grid>

        <!--  Кривая: полосы тянутся прямо по ней  -->
        <Border
            Grid.Row="1"
            Margin="0,10,0,0"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="3">
            <controls:EqualizerCurveView
                Bands="{Binding Bands}"
                HighCutHz="{Binding HighCut.Value}"
                IsActive="{Binding IsEnabled}"
                LowCutHz="{Binding LowCut.Value}"
                PreampDb="{Binding Preamp.Value}" />
        </Border>

        <!--  Общий makeup-gain и два среза: те же крутилки, что у остальных эффектов  -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Sm.Eq.Shaping}" />
            <ItemsControl ItemTemplate="{StaticResource EffectKnobTemplate}" ItemsSource="{Binding Knobs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <!--  Кнопки  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Command="{Binding FlatCommand}"
                Content="{DynamicResource Sm.Eq.Flat}"
                ToolTip="{DynamicResource Sm.Eq.FlatTip}" />
            <Button
                Margin="8,0,0,0"
                Click="OnCloseClick"
                Content="{DynamicResource Sm.Common.Close}"
                IsCancel="True"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>