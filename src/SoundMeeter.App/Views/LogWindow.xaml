<Window
    x:Class="SoundMeeter.Views.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{DynamicResource Sm.Log.Title}"
    Width="900"
    Height="600"
    MinWidth="520"
    MinHeight="320"
    Background="#252526"
    Foreground="#EEE"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <StackPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="11"
                Text="{DynamicResource Sm.Log.Level}" />
            <ComboBox
                Width="110"
                VerticalAlignment="Center"
                ItemsSource="{Binding LogLevels}"
                SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                ToolTip="{DynamicResource Sm.Log.LevelTip}" />
            <TextBlock
                Margin="16,0,8,0"
                VerticalAlignment="Center"
                FontSize="11"
                Text="{DynamicResource Sm.Log.File}" />
            <ComboBox
                Width="230"
                VerticalAlignment="Center"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Files}"
                SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                ToolTip="{DynamicResource Sm.Log.FileTip}" />
            <Button
                Margin="8,0,0,0"
                Command="{Binding RefreshCommand}"
                Content="{DynamicResource Sm.Common.Refresh}" />
            <Button
                Margin="6,0,0,0"
                Command="{Binding OpenLogFolderCommand}"
                Content="{DynamicResource Sm.Log.Folder}"
                ToolTip="{DynamicResource Sm.Log.FolderTip}" />
            <Button
                Margin="6,0,0,0"
                Command="{Binding CopyDiagnosticsCommand}"
                Content="{DynamicResource Sm.Log.CopyDiagnostics}"
                ToolTip="{DynamicResource Sm.Log.CopyDiagnosticsTip}" />
        </StackPanel>

        <StatusBar
            Background="Transparent"
            DockPanel.Dock="Bottom"
            Foreground="#9A9A9A">
            <StatusBarItem>
                <TextBlock FontSize="10" Text="{Binding Status}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock
                    FontSize="10"
                    Foreground="#7E7E7E"
                    Text="{Binding LogDirectory}" />
            </StatusBarItem>
        </StatusBar>

        <TextBox
            AcceptsReturn="True"
            Background="#1E1E1E"
            BorderBrush="#3F3F46"
            FontFamily="Consolas, Courier New"
            FontSize="11"
            Foreground="#D4D4D4"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            Text="{Binding Content, Mode=OneWay}"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>