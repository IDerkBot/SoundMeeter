<UserControl
    x:Class="SoundMeeter.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SoundMeeter.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:SoundMeeter.Update.Presentation.Views;assembly=SoundMeeter.Update.Presentation"
    xmlns:vm="clr-namespace:SoundMeeter.ViewModels"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SoundMeeter;component/Views/Controls/MixerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height=".7*" />
        </Grid.RowDefinitions>

        <!--  Панель инструментов; баннер обновления накладывается справа  -->
        <Grid Grid.Row="0">
            <controls:MixerToolbarView />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <views:UpdateBannerView DataContext="{Binding Update}" />
                <views:UpdateStatusView DataContext="{Binding Update}" />
            </StackPanel>
        </Grid>

        <!--  Советы: нет виртуального кабеля  -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border
                Padding="8,5"
                Background="#5A3B00"
                CornerRadius="3"
                Visibility="{Binding HasVirtualCable, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="{DynamicResource Sm.Main.NoVirtualCable}" />
            </Border>
        </StackPanel>

        <!--  Стрипы: входы и выходы  -->
        <controls:MixerView Grid.Row="2" />

        <!--  Приложения с аудио и установленные приложения  -->
        <Border
            Grid.Row="3"
            Background="#252526"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="330" />
                    <ColumnDefinition Width="*" MinWidth="660" />
                </Grid.ColumnDefinitions>
                <controls:RunningAppsView Grid.Column="0" />
                <GridSplitter
                    Grid.Column="0"
                    Width="2"
                    Margin="0,20"
                    Background="#69696E" />
                <controls:InstalledAppsView Grid.Column="2" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
