<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      UseWPF здесь НЕ включён, и это требование, а не забывчивость.

      SoundMeeter.Audio ссылается на этот проект (SettingsMigrator и MidiSettings
      берут строки через Loc.Get), а Audio обязан оставаться сборкой без WPF.
      Если объявить UseWPF здесь ради LocResources — WPF попадёт в сборку
      ChangeLanguage и по цепочке ProjectReference окажется у Audio, то есть
      ядро обработки звука начнёт зависеть от PresentationFramework.

      Поэтому мост WPF (LocResources: подмешивание словаря в Application.Resources)
      живёт в самом приложении, а здесь остаётся только Loc — чистый BCL без
      System.Windows. Проверяет это LocTests и сборка Audio.
    -->
    <!--
      RootNamespace намеренно НЕ SoundMeeter.ChangeLanguage.

      Имя встроенного ресурса выводится как $(RootNamespace).путь.имя, а Loc
      ищет строки по базовому имени "SoundMeeter.Resources.Strings". Со сменой
      RootNamespace ресурс стал бы SoundMeeter.ChangeLanguage.Resources.Strings, и
      Loc.Get() начал бы возвращать ⟨Sm.Ключ⟩ вместо текста — тихо, без
      исключения, только в интерфейсе.

      Все .cs объявляют namespace явно, так что на них RootNamespace не влияет.
      Что именно лежит в ресурсе, проверяет LocTests.EveryResourceFileKeyResolves.
    -->
    <RootNamespace>SoundMeeter</RootNamespace>
    <AssemblyName>SoundMeeter.ChangeLanguage</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SoundMeeter.Audio" />
    <InternalsVisibleTo Include="SoundMeeter.Update" />
    <InternalsVisibleTo Include="SoundMeeter.TrayIcon" />
    <InternalsVisibleTo Include="SoundMeeter" />
    <InternalsVisibleTo Include="SoundMeeter.ChangeLanguage.Tests" />
  </ItemGroup>

</Project>