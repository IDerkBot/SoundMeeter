<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!--
      Тот же RID, что у SoundMeeter: без него проект собирается как MSIL, а
      ссылка на win-x64-сборку даёт MSB3270 и расхождение архитектур.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Тесты дёргают устаревшие API NAudio (MmDevice, WasapiCapture) так же,
         как и сам модуль: предупреждения о них повторяют предупреждения сборки
         SoundMeeter.Core и не дают ничего нового. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Приложение целиком: этим тестам нужен XAML (pack-URI на MixerTheme.xaml),
      UserControl-ы стрипов и STA-хост с настоящим Application. Core приезжает
      транзитивно — видно его и явно, раз App его ссылается.

      Ссылки на SoundMeeter.App достаточно, чтобы ModuleBoundaryTests увидел ВСЕ
      сборки решения: App → Core → {Audio, Logger, ChangeLanguage, Update, StartUp}
      и App → TrayIcon. Раньше тот же эффект давал единственный SoundMeeter.Tests.
    -->
    <ProjectReference Include="..\SoundMeeter.App\SoundMeeter.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Фикстуры ViewModel-ов (Strips, FakeAudioEngine) живут в SoundMeeter.Core.Tests
      — они принадлежат ядру. Дублировать их ради App.Tests нельзя: FakeAudioEngine
      — это реализация IAudioEngine, и вторая копия рано или поздно разойдётся с
      первой по сигнатуре, а тесты будут падать в зависимости от того, какой проект
      их запустил. Поэтому линкуем исходники: одна правка — два проекта.

      Про ссылку на проект тестов вместо этого — нельзя: тестовый проект не должен
      быть зависимостью другого тестового проекта (иначе App.Tests утащил бы в
      выход ещё и раннер, а Core.Tests — тесты, которым не нужен UI).

      Namespace остаётся SoundMeeter.Tests.Infrastructure: файлы те же самые, меняется
      только сборка, в которую они попали. Оба тестовых проекта в одном прогоне не
      бывают (никакой проект не ссылается на оба), так что совпадение имён не
      создаёт неоднозначности.
    -->
    <Compile Include="..\SoundMeeter.Core.Tests\Infrastructure\Strips.cs" Link="Infrastructure\Strips.cs" />
    <Compile Include="..\SoundMeeter.Core.Tests\Infrastructure\FakeAudioEngine.cs" Link="Infrastructure\FakeAudioEngine.cs" />
    <!-- Заглушка ITextToSpeechHost: окно настроек TTS проверяется настоящей разметкой,
         и без неё проверку пришлось бы поднимать всё приложение целиком. -->
    <Compile Include="..\SoundMeeter.Core.Tests\Infrastructure\FakeTextToSpeechHost.cs" Link="Infrastructure\FakeTextToSpeechHost.cs" />
  </ItemGroup>

</Project>