<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoundMeeter.Services.Logging</RootNamespace>
    <AssemblyName>SoundMeeter.Logger</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SoundMeeter.ChangeLanguage" />
    <InternalsVisibleTo Include="SoundMeeter.Audio" />
    <InternalsVisibleTo Include="SoundMeeter.Update" />
    <InternalsVisibleTo Include="SoundMeeter.StartUp" />
    <InternalsVisibleTo Include="SoundMeeter.TrayIcon" />
    <!-- SoundMeeter — это имя сборки приложения (SoundMeeter.App.csproj),
         SoundMeeter.Core — новый слой с ViewModels и сервисами. -->
    <InternalsVisibleTo Include="SoundMeeter.Core" />
    <InternalsVisibleTo Include="SoundMeeter" />
  </ItemGroup>

</Project>