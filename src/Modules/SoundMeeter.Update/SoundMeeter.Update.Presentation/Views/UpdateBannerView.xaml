<UserControl
    x:Class="SoundMeeter.Update.Presentation.Views.UpdateBannerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SoundMeeter.Framework.Presentation.Converters;assembly=SoundMeeter.Framework.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SoundMeeter.Update.Presentation.ViewModels"
    d:DataContext="{d:DesignInstance vm:UpdateViewModel}"
    d:DesignHeight="34"
    d:DesignWidth="420"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border
        Height="34"
        Margin="0,0,0,6"
        Padding="8,2"
        HorizontalAlignment="Right"
        Background="#318849"
        BorderBrush="#32C75B"
        BorderThickness="2"
        CornerRadius="6"
        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
            <Button
                Height="30"
                Margin="0,0,4,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                Command="{Binding RequestInstallCommand}"
                Content="{DynamicResource Sm.Toolbar.CheckUpdates}" />
            <Border
                Width="2"
                Height="26"
                BorderBrush="#32C75B"
                BorderThickness="2" />
            <Button
                Height="30"
                Margin="4,0,0,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                Command="{Binding DismissUpdateCommand}"
                Content="Не обновлять"
                ToolTip="{DynamicResource Sm.Update.Banner.DismissTip}" />
        </DockPanel>
    </Border>
</UserControl>