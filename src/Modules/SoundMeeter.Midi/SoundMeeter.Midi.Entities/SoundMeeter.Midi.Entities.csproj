<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SoundMeeter.Midi.Entities</RootNamespace>
    <AssemblyName>SoundMeeter.Midi.Entities</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    DTO модуля MIDI: разобранное сообщение от контроллера и найденное при
    опросе устройство ввода. Это данные пересылки, а не поведение, поэтому
    отдельным слоем — как Docking.Entities и Update.Entities.

    Ссылка на Core.Contract нужна ради MidiMessageKind: вид сообщения (CC,
    NoteOn, NoteOff, PitchWheel) живёт там, потому что на нём держится
    MidiBinding.MessageKind в settings.json. Уводить перечисление сюда значило
    бы заставить Core знать про MIDI.
  -->

</Project>
