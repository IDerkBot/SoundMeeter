<Window
    x:Class="SoundMeeter.Midi.Presentation.MidiBindingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:attachedProperties="clr-namespace:StreamerTools.Style.AttachedProperties;assembly=StreamerTools.Style"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SoundMeeter.Midi.Presentation.ViewModels"
    Title="{DynamicResource Sm.Midi.Title}"
    Width="720"
    Height="560"
    MinWidth="640"
    MinHeight="400"
    d:DataContext="{d:DesignInstance vm:MidiBindingsViewModel}"
    Background="#1E1E1E"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Left">
            <TextBlock
                Margin="5,0,8,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#CCC"
                Text="{DynamicResource Sm.Midi.Input}" />
            <ComboBox
                MinWidth="200"
                DisplayMemberPath="Display"
                ItemsSource="{Binding DeviceOptions}"
                SelectedItem="{Binding SelectedDevice}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,8"
            Padding="8,4"
            Background="#2B2B2B"
            CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Foreground="#9A9A9A" Text="{DynamicResource Sm.Midi.Status}" />
                <TextBlock Foreground="#EEE" Text="{Binding Status}" />
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel.Resources>
                    <Style x:Key="CellLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="Foreground" Value="#AAA" />
                        <Setter Property="TextAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="CellDisplay" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="TextAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,2,0,0" />
                        <Setter Property="Foreground" Value="#EEE" />
                    </Style>
                    <Style
                        x:Key="CellButton"
                        BasedOn="{StaticResource {x:Type Button}}"
                        TargetType="Button">
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="Margin" Value="0,4,4,0" />
                    </Style>
                    <Style x:Key="StripHeader" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="#DDD" />
                        <Setter Property="Margin" Value="0,10,0,6" />
                    </Style>
                </StackPanel.Resources>

                <ItemsControl ItemsSource="{Binding Strips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="280"
                                Margin="0,0,10,0"
                                Padding="5"
                                VerticalAlignment="Top"
                                Background="#262626"
                                BorderBrush="#3A3A3A"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        Padding="0"
                                        FontSize="20"
                                        Style="{StaticResource StripHeader}"
                                        Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Margin="0,0,0,10">
                                                    <Expander.Header>
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="#CCC"
                                                            Text="{Binding Title}" />
                                                    </Expander.Header>
                                                    <StackPanel Margin="8,4,0,0">
                                                        <ItemsControl ItemsSource="{Binding Params}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,0,0,5">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="*" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <StackPanel>
                                                                            <TextBlock
                                                                                FontSize="12"
                                                                                FontWeight="Bold"
                                                                                Foreground="#FFFFFF"
                                                                                Text="{Binding Descriptor.Key}"
                                                                                TextAlignment="Left" />

                                                                            <TextBlock
                                                                                FontSize="12"
                                                                                FontWeight="Light"
                                                                                Foreground="#FFFFFF"
                                                                                Text="{Binding Display, Mode=OneWay}"
                                                                                TextAlignment="Left" />
                                                                        </StackPanel>

                                                                        <StackPanel
                                                                            Grid.Row="0"
                                                                            Grid.Column="1"
                                                                            HorizontalAlignment="Right"
                                                                            Orientation="Horizontal">
                                                                            <Button
                                                                                Width="30"
                                                                                Height="30"
                                                                                Margin="0"
                                                                                attachedProperties:Button.Icon="Pencil"
                                                                                attachedProperties:Button.Position="First"
                                                                                Command="{Binding LearnCommand}"
                                                                                Style="{StaticResource CellButton}" />
                                                                            <Button
                                                                                Width="30"
                                                                                Height="30"
                                                                                Margin="0"
                                                                                attachedProperties:Button.Icon="Close"
                                                                                attachedProperties:Button.Position="Last"
                                                                                Command="{Binding ClearCommand}"
                                                                                IsEnabled="{Binding IsBound}"
                                                                                Style="{StaticResource CellButton}" />
                                                                        </StackPanel>

                                                                        <ComboBox
                                                                            Grid.Row="1"
                                                                            Grid.Column="0"
                                                                            Width="140"
                                                                            Margin="0,5,0,0"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center"
                                                                            DisplayMemberPath="Name"
                                                                            FontSize="10"
                                                                            ItemsSource="{Binding ModeOptions}"
                                                                            SelectedValue="{Binding Mode}"
                                                                            SelectedValuePath="Value"
                                                                            ToolTip="{DynamicResource Sm.Midi.ModeTip}"
                                                                            Visibility="{Binding IsButton, Converter={StaticResource BoolToVis}}" />

                                                                        <CheckBox
                                                                            Grid.Row="1"
                                                                            Grid.Column="1"
                                                                            Margin="0,5,5,0"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Content="{DynamicResource Sm.Midi.Reverse}"
                                                                            FontSize="10"
                                                                            Foreground="#CCC"
                                                                            IsChecked="{Binding IsInverted}"
                                                                            Style="{StaticResource CheckBoxCompact}"
                                                                            ToolTip="{DynamicResource Sm.Midi.ReverseTip}"
                                                                            Visibility="{Binding IsButton, Converter={StaticResource BoolToVis}}" />

                                                                        <Border
                                                                            Grid.Row="2"
                                                                            Grid.Column="0"
                                                                            Grid.ColumnSpan="2"
                                                                            Margin="0,4,0,0"
                                                                            BorderBrush="#3A3A3A"
                                                                            BorderThickness="0,0,0,1" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="3"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Padding="18,5"
                Click="OnCloseClick"
                Content="{DynamicResource Sm.Midi.Close}"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>