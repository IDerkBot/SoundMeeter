<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SoundMeeter.Services</RootNamespace>
    <AssemblyName>SoundMeeter.Docking.UseCases</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundMeeter.Docking.Contract\SoundMeeter.Docking.Contract.csproj" />
    <ProjectReference Include="..\SoundMeeter.Docking.Entities\SoundMeeter.Docking.Entities.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Infrastructure\SoundMeeter.Infrastructure.Logger\SoundMeeter.Infrastructure.Logger.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Core\SoundMeeter.Core.Contract\SoundMeeter.Core.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\obs-dock\index.html" LogicalName="obs-dock.index.html" />
    <EmbeddedResource Include="Resources\obs-dock\dock.css" LogicalName="obs-dock.dock.css" />
    <EmbeddedResource Include="Resources\obs-dock\dock.js" LogicalName="obs-dock.dock.js" />
  </ItemGroup>

</Project>
