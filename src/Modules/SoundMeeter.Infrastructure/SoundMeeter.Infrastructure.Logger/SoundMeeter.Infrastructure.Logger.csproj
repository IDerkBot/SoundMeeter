    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SoundMeeter.Services.Logging</RootNamespace>
    <AssemblyName>SoundMeeter.Infrastructure.Logger</AssemblyName>
