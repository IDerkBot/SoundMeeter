<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SoundMeeter.Core.UseCases</RootNamespace>
    <AssemblyName>SoundMeeter.Core.UseCases</AssemblyName>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
  </ItemGroup>

  <!--
    Сценарии ядра: MixerCoordinator (движок, таймеры, пресет, импорт и экспорт),
    AppBehaviourService (трей и автозапуск), StripProvider (реестр стрипов для
    MIDI, дока и озвучки) и InstalledAppsService.

    Восемь ссылок отсюда ушли вместе с представлением главного окна: пока в
    этой сборке жили MainViewModel и полосы микшера, проект тянул Midi.Presentation,
    Audio.Dsp, AppRouting.Entities, Update.UseCases, StartUp.UseCases и ещё три
    контракта. Теперь ни одна из них не нужна, и список ниже совпадает с
    фактическим составом собранной сборки — CoreLayeringBoundaryTests проверяет
    именно его.

    SoundMeeter.Core.Presentation здесь быть не должно никогда: обратная ссылка
    означала бы, что сценарии снова начали знать о ViewModel.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\SoundMeeter.AppRouting\SoundMeeter.AppRouting.Contract\SoundMeeter.AppRouting.Contract.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Infrastructure\SoundMeeter.Infrastructure.Contract.Implementation\SoundMeeter.Infrastructure.Contract.Implementation.csproj" />
    <ProjectReference Include="..\SoundMeeter.Core.Contract\SoundMeeter.Core.Contract.csproj" />
    <ProjectReference Include="..\SoundMeeter.Core.Entities\SoundMeeter.Core.Entities.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Audio\SoundMeeter.Audio.Contract\SoundMeeter.Audio.Contract.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Midi\SoundMeeter.Midi.UseCases\SoundMeeter.Midi.UseCases.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.TextToSpeech\SoundMeeter.TextToSpeech.UseCases\SoundMeeter.TextToSpeech.UseCases.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Twitch\SoundMeeter.Twitch.UseCases\SoundMeeter.Twitch.UseCases.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Docking\SoundMeeter.Docking.UseCases\SoundMeeter.Docking.UseCases.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.StartUp\SoundMeeter.StartUp.Contract\SoundMeeter.StartUp.Contract.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.ChangeLanguage\SoundMeeter.ChangeLanguage.UseCases\SoundMeeter.ChangeLanguage.UseCases.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SoundMeeter.Core.Tests" />
    <InternalsVisibleTo Include="SoundMeeter.App.Tests" />
    <InternalsVisibleTo Include="SoundMeeter.Audio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\system_apps_filter.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Resources\system_apps_filter.json" LogicalName="soundmeeter.system-apps-filter.json" />
  </ItemGroup>

</Project>
