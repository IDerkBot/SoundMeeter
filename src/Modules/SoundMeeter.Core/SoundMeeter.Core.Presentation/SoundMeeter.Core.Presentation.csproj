<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SoundMeeter.Core.Presentation</RootNamespace>
    <AssemblyName>SoundMeeter.Core.Presentation</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- UseWPF намеренно НЕ включён, и теперь это не «пока рано», а постоянное
         свойство слоя. Здесь живут только ViewModel'ы: они держат наблюдаемые
         свойства и команды, но ни одна не трогает System.Windows. Разметка и её
         код-behind остаются в приложении.

         Флаг включать нельзя «на будущее»: сборка объявила бы зависимость от
         PresentationFramework, которую граничные проверки справедливо сочли бы
         утечкой. Если когда-нибудь окна приедут сюда — это будет отдельное
         решение с отдельным обоснованием, а не побочный эффект переноса VM. -->
  </PropertyGroup>

  <!--
    Представление ядра: главное окно микшера и окна поверх него.

    Здесь два разных по природе класса, и раньше они лежали в разных сборках.

    Окна поверх главного (LogViewModel, TextToSpeechSettingsViewModel,
    TwitchSettingsViewModel) — пассивные: получают состояние через контракт и
    показывают его. Сценариев они не знают.

    Главное окно (MainViewModel и полосы микшера) — активное: оно вызывает
    сценарии, потому что это и есть назначение представления. Ссылки на
    SoundMeeter.Core.UseCases и модули — вниз, и это разрешённое направление,
    то же, что Midi.Presentation → Midi.UseCases.

    Почему раньше главное окно лежало в UseCases и почему это перестало быть
    проблемой. MainViewModel была одновременно оркестратором и ViewModel: держала
    коллекции полос для разметки, создавала их элементы, подписывалась на движок,
    мерила метры и писала settings.json. Пока это всё было в одном классе, слои
    нельзя было развести: сценарий не мог обойтись без ViewModel'ов полос, а
    ViewModel не мог быть собран без сценариев. Оркестрация уехала в
    MixerCoordinator, AppBehaviourService и StripProvider (SoundMeeter.Core.UseCases),
    и представление осталось тем, чем является по существу.

    Обратной ссылки на этот проект у UseCases быть не может: CoreWpfFreeTests и
    CoreLayeringIntentTests проверяют её по метаданным сборки.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- Вход в Twitch проверяется через StartLoginAsync/PollOnceAsync. Они
       internal не по недосмотру, а чтобы окно не дёргало их случайно, и
       InternalsVisibleTo был у старого проекта Core.UseCases — после переноса
       его нужно объявить заново, иначе проверки входа перестают собираться. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SoundMeeter.Core.Tests" />
    <InternalsVisibleTo Include="SoundMeeter.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundMeeter.Core.Contract\SoundMeeter.Core.Contract.csproj" />
    <ProjectReference Include="..\SoundMeeter.Core.Entities\SoundMeeter.Core.Entities.csproj" />
    <!-- Оркестрация: MixerCoordinator (движок, таймеры, пресет, импорт/экспорт),
         AppBehaviourService (трей и автозапуск) и StripProvider. Всё это — вниз,
         в сценарии; обратной ссылки оттуда нет. -->
    <ProjectReference Include="..\SoundMeeter.Core.UseCases\SoundMeeter.Core.UseCases.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Audio\SoundMeeter.Audio.Contract\SoundMeeter.Audio.Contract.csproj" />
    <!-- Полосы фильтруют сигнал: EqualizerViewModel и StripEffectViewModel
         считают по DSP-типам напрямую, без прослойки. -->
    <ProjectReference Include="..\..\SoundMeeter.Audio\SoundMeeter.Audio.Dsp\SoundMeeter.Audio.Dsp.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.ChangeLanguage\SoundMeeter.ChangeLanguage.UseCases\SoundMeeter.ChangeLanguage.UseCases.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Infrastructure\SoundMeeter.Infrastructure.Logger\SoundMeeter.Infrastructure.Logger.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Infrastructure\SoundMeeter.Infrastructure.Settings\SoundMeeter.Infrastructure.Settings.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.AppRouting\SoundMeeter.AppRouting.Entities\SoundMeeter.AppRouting.Entities.csproj" />
    <!-- Модули, чьи окна открываются из главного. Ссылки на ИХ сценарии, а не на
         контракты: окно настроек дока умеет применять настройки, а окно Twitch —
         начинать вход, то есть это не пассивные наблюдатели. -->
    <ProjectReference Include="..\..\SoundMeeter.Twitch\SoundMeeter.Twitch.Contract\SoundMeeter.Twitch.Contract.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Twitch\SoundMeeter.Twitch.Entities\SoundMeeter.Twitch.Entities.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Twitch\SoundMeeter.Twitch.UseCases\SoundMeeter.Twitch.UseCases.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.TextToSpeech\SoundMeeter.TextToSpeech.Contract\SoundMeeter.TextToSpeech.Contract.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.TextToSpeech\SoundMeeter.TextToSpeech.Entities\SoundMeeter.TextToSpeech.Entities.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.TextToSpeech\SoundMeeter.TextToSpeech.UseCases\SoundMeeter.TextToSpeech.UseCases.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Update\SoundMeeter.Update.Entities\SoundMeeter.Update.Entities.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Update\SoundMeeter.Update.UseCases\SoundMeeter.Update.UseCases.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Midi\SoundMeeter.Midi.UseCases\SoundMeeter.Midi.UseCases.csproj" />
    <ProjectReference Include="..\..\SoundMeeter.Docking\SoundMeeter.Docking.UseCases\SoundMeeter.Docking.UseCases.csproj" />
  </ItemGroup>

</Project>