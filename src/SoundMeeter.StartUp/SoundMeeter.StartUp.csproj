<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoundMeeter.Services</RootNamespace>
    <AssemblyName>SoundMeeter.StartUp</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      Запуск приложения: автозапуск вместе с Windows через задачу планировщика с
      RunLevel=Highest (SM-D01, нужен для AppRouting) и гарантия одного
      работающего экземпляра (SM-D03). Обе задачи — про то, как приложение ведёт
      себя в сеансе Windows, поэтому живут вместе.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundMeeter.Logger\SoundMeeter.Logger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SoundMeeter — сборка приложения (MainWindow), SoundMeeter.Core —
         MainViewModel.Behaviour.cs. -->
    <InternalsVisibleTo Include="SoundMeeter.Core" />
    <InternalsVisibleTo Include="SoundMeeter" />
    <InternalsVisibleTo Include="SoundMeeter.StartUp.Tests" />
  </ItemGroup>

</Project>