<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>SoundMeeter.Audio</AssemblyName>
    <!--
      Тот же RID, что у приложения: иначе runtime-ассеты транзитивных пакетов
      (rnnoise.dll из YellowDogMan.RRNoise.NET) не копируются в выход.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!--
      Ресемплер держит unsafe-буферы, а RnNoiseInterop зовёт rnnoise.dll через
      P/Invoke: оба живут в Audio\, то есть здесь.
    -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
    <!-- SM-A03: нужен ради runtimes\win-x64\native\rnnoise.dll; managed-обёртка
         пакета не используется (см. комментарий в Audio\RnNoiseInterop.cs). -->
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Журнал и строки локализации вынесены в отдельные сборки (SM-A09). Раньше
      AppLog и Loc жили здесь, и ядро обработки звука зависело от
      PresentationFramework только ради строки в сообщении об ошибке.
    -->
    <ProjectReference Include="..\SoundMeeter.Logger\SoundMeeter.Logger.csproj" />
    <ProjectReference Include="..\SoundMeeter.ChangeLanguage\SoundMeeter.ChangeLanguage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Кто имеет право видеть internal: ядро (SoundMeeter.Core — ViewModels и
      WasapiAudioEngine), приложение (SoundMeeter.App — имя сборки exe осталось
      прежним) и оба тестовых проекта. SoundMeeter.Tests больше не существует —
      после разделения на Core/App его логику и UI разнесли по
      SoundMeeter.Core.Tests и SoundMeeter.App.Tests.
    -->
    <InternalsVisibleTo Include="SoundMeeter.Audio.Tests" />
    <InternalsVisibleTo Include="SoundMeeter.Core.Tests" />
    <InternalsVisibleTo Include="SoundMeeter.App.Tests" />
    <InternalsVisibleTo Include="SoundMeeter.Core" />
    <InternalsVisibleTo Include="SoundMeeter" />
  </ItemGroup>

</Project>
