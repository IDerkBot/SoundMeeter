<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Версия, которую сравниваем с тегом GitHub Releases (AppVersion.Current). -->
    <Version>0.0.1</Version>
    <ApplicationIcon>Resources\Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!--
      NAudio и Microsoft.Extensions.Logging нужны и здесь: WasapiAudioEngine,
      AudioService и MidiService остались в приложении, а ILogger внедряется
      через DI. Денойзер и ресемплер живут в SoundMeeter.Audio.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <!--
      rnnoise.dll нужна и здесь: сборка приложения portable (PublishSingleFile),
      и нативный ассет из пакета копируется по цепочке ссылок, а не напрямую.
      Обращаемся к ней через RnNoiseInterop в SoundMeeter.Audio: managed-обёртка
      RNNoise.NET.Denoiser скрывает своё кольцо буфера, из-за чего «сухой» и
      «денойзерный» сигналы расходятся по времени, и не отдаёт вероятность
      речи (VAD).
    -->
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" />
  </ItemGroup>

<ItemGroup>
    <!--
      Модули приложения вынесены в отдельные сборки (SM-A09). Каждая отвечает за
      одну задачу и тянет ровно то, что нужно ей:

        SoundMeeter.Audio         обработка звука, модель пресета, миграции (без WPF)
        SoundMeeter.Logger        журнал в ротируемый файл (SM-A03)
        SoundMeeter.ChangeLanguage строки локализации EN/RU (SM-C07)
        SoundMeeter.Update        обновление с GitHub Releases (SM-A06/SM-E03)
        SoundMeeter.StartUp       автозапуск вместе с Windows и один экземпляр (SM-D01/D03)
        SoundMeeter.TrayIcon      значок в системном лотке (SM-D02)

      Направление ссылок одно: модули ссылаются на Logger и ChangeLanguage, но не
      друг на друга и никогда — на приложение. Поэтому циклов не возникает, а
      переезд отдельной задачи не задевает остальные.
    -->
    <ProjectReference Include="..\SoundMeeter.Audio\SoundMeeter.Audio.csproj" />
    <ProjectReference Include="..\SoundMeeter.Logger\SoundMeeter.Logger.csproj" />
    <ProjectReference Include="..\SoundMeeter.ChangeLanguage\SoundMeeter.ChangeLanguage.csproj" />
    <ProjectReference Include="..\SoundMeeter.Update\SoundMeeter.Update.csproj" />
    <ProjectReference Include="..\SoundMeeter.StartUp\SoundMeeter.StartUp.csproj" />
    <ProjectReference Include="..\SoundMeeter.TrayIcon\SoundMeeter.TrayIcon.csproj" />
    <ProjectReference Include="..\..\StreamerTools.Style\StreamerTools.Style.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\system_apps_filter.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Панель док-панели OBS: вшиваем в сборку, чтобы док работал сразу после
       запуска (и после автообновления portable-сборки) без файлов на диске. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\obs-dock\index.html" LogicalName="obs-dock.index.html" />
    <EmbeddedResource Include="Resources\obs-dock\dock.css" LogicalName="obs-dock.dock.css" />
    <EmbeddedResource Include="Resources\obs-dock\dock.js" LogicalName="obs-dock.dock.js" />
  </ItemGroup>

</Project>
