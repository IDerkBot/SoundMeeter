<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoundMeeter.Models</RootNamespace>
    <AssemblyName>SoundMeeter.Update</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      Обновление с GitHub Releases: проверка релиза, выбор portable-артефакта,
      план установки и его применение (SM-A06/SM-E03).

      Отдельная сборка по существу: механизм обновления — единственная часть
      приложения, у которой есть внешний контракт (GitHub API, PowerShell,
      подпись Authenticode) и которую имеет смысл заменить целиком. Реализация
      называется GithubUpdateService, потому что источником релизов может быть
      не только GitHub; контракт для остального приложения остаётся
      IUpdateService, и следующий источник добавится рядом, не трогая UI.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundMeeter.Logger\SoundMeeter.Logger.csproj" />
    <ProjectReference Include="..\SoundMeeter.ChangeLanguage\SoundMeeter.ChangeLanguage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SoundMeeter" />
    <InternalsVisibleTo Include="SoundMeeter.Update.Tests" />
  </ItemGroup>

</Project>